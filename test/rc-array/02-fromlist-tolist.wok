module Main
import Base
import Array

-- Exercise fromList / toList round-trip and confirm that converting back to a
-- list and summing recovers the original values.
--
-- Plan:
--   xs   = [10, 20, 30, 40]        -- a list
--   arr  = fromList xs             -- Array U64
--   ys   = toList arr              -- back to a list
--   main = sum of ys               -- 10 + 20 + 30 + 40 = 100

sumList : [U64] -> U64
sumList xs = case xs of
  []     -> 0
  h :: t -> h + sumList t

main : U64
main =
  let xs  = [10, 20, 30, 40] in
  let arr = fromList xs in
  let ys  = toList arr in
  sumList ys
