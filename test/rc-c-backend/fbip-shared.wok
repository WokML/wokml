module Main
import Std.Base

-- FBIP shared-cell fallback (Task 5, §10.1.3): 'tail' is shared between two
-- lists, so the 'Cons' cells of 'tail' carry rc > 1 when 'mapInc' reaches them.
-- The runtime 'rc == 1' gate then yields a NULL reuse token and 'alloc_at'
-- allocates fresh for the shared cells --- reuse does NOT fire on them (the head
-- 'Cons 1' is unique and CAN reuse, but the shared spine cannot). Correctness is
-- unaffected: a wrong uniqueness guess only ever costs an allocation. We sum the
-- mapped list and the shared tail so both references are genuinely live, and the
-- abstract and C backends agree on the (fresh-allocating) counts.

data List = Nil | Cons U64 List

mapInc : List -> List
mapInc xs = case xs of
  Nil       -> Nil
  Cons x xx -> Cons (x + 1) (mapInc xx)

sumList : List -> U64
sumList xs = case xs of
  Nil       -> 0
  Cons y ys -> y + sumList ys

main =
  let tail = Cons 2 (Cons 3 Nil) in
  let whole = Cons 1 tail in
  sumList (mapInc whole) + sumList tail
