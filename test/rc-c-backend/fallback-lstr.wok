module Main
import Std.Base

-- String field as a POINTER cell (Slice E1, Task 3): a constructor with a
-- 'String' field. A string literal now allocates a counted 'NString' cell, and
-- the field stores its pointer ('encodeSlotC' -> 'KPointer'), so the whole
-- 'Tagged' NCon is C-eligible (it no longer falls back to the abstract heap).
-- Both the 'NString' cell and the 'Tagged' NCon route to the C heap; the program
-- still renders the correct result and returns to its baseline with balanced
-- stats.

data Tagged = Tagged String U64

tagOf : Tagged -> U64
tagOf t = case t of Tagged s k -> k

main = tagOf (Tagged "hi" 1)
