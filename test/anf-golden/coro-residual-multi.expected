producer u =
  let t.5 = Coro.suspend(7)
  let x = t.5
  let t.4 = Log.emit(x)
  let v = t.4
  let t.3 = Tick.tick()
  let t.1 = t.3
  let t.2 = +(x, t.1)
  t.2

drive u =
  let t.1 = start(producer)
  case t.1 of
    Completed r -> r
    Suspended _ g ->
      let t.2 = run(g, 5)
      t.2
  with {
    return v.1 -> v.1
    Log.emit(n, resume.1) ->
      let t.3 = resume.1(())
      t.3
  }
  with {
    return v.2 -> v.2
    Tick.tick(resume.2) ->
      let t.4 = resume.2(1)
      t.4
  }

main =
  let t = drive(())
  t
