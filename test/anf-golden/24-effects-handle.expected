runIO comp =
  let t = comp(())
  t
  with {
    return v -> v
    IO.read(p, resume.1) ->
      let res.1 = resume.1(p)
      res.1
    IO.write(m, resume.2) ->
      let res.2 = resume.2(())
      res.2
  }

runIO2 comp =
  let t = comp(())
  t
  with {
    return v -> v
    IO.read(p, resume.1) ->
      let res.1 = resume.1(p)
      res.1
    IO.write(m, resume.2) ->
      let res.2 = resume.2(())
