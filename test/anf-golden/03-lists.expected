myLength xs =
  case xs of
    Nil -> 0
    Cons _ ys ->
      let t.1 = myLength(ys)
      let t.2 = +(1, t.1)
      t.2

myMap f xs =
  case xs of
    Nil ->
      let t.1 = Nil
      t.1
    Cons y ys ->
      let t.2 = f(y)
      let t.3 = Nil
      let t.4 = Cons(t.2, t.3)
      let t.5 = myMap(f, ys)
      let t.6 = ++(t.4, t.5)
      t.6
