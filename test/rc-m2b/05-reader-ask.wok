module Main
import Base

-- M2b-1 Task 5: TAIL RESUME with a constant. 'reader' installs a Reader handler
-- whose 'ask' arm auto-resumes with the seeded constant 'n' (the elaborator
-- expands 'ask -> n' to 'ask(resume) -> resume(n)'). 'prog' performs 'ask' then
-- continues; the resume splices the captured frame (the 'let m = ... in m + 1'
-- frame above the op) back onto the live continuation and delivers 'n' into it.
-- The NCont shell is freed WITHOUT cascading its children (the spliced frame's
-- own drops fire as it runs). Output is '10 + 1 = 11'; the heap returns to
-- baseline (no leak from a missed shell free, no double-free from a spurious
-- cascade).
effect Reader = { ask : U64 }

reader : U64 -> (Reader -> a with Reader + eff e) -> a with eff e
reader n c = with self = Reader { ask -> n } in c self

prog : Reader -> U64 with Reader
prog r = let m = r.ask in m + 1

main : U64
main = reader 10 prog
