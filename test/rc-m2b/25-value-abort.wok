module Main
import Std.Base

-- M2b-2 Task 5: value-position handler whose op arm ABORTS (no resume call).
-- The 'with' is in non-tail position within 'main': its result is used in a
-- subsequent case, so hAnswerJoin = Just. On abort the NCont's owned set is
-- freed (empty here: no boxed values above the op) and None is returned;
-- the answer-rebind is a no-op on the abort path (no resume, no join redirect).
-- Expected output: None; heap returns to baseline.
effect Exn = { throw : U64 -> Never }

prog : Exn -> U64 with Exn
prog e = e.throw 5

main : Option U64
main =
  let r = (with self = Exn { throw n k -> None ; v -> Some v } in prog self) in
  case r of
    None    -> None
    Some v  -> Some (v + 1)
