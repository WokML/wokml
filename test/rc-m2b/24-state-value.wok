module Main
import Std.Base

-- M2b-2 Task 5: value-position handler. The 'with' block is in non-tail
-- position within 'main': its result is destructured by a case expression,
-- so hAnswerJoin = Just (arms deliver to a join point that continues into the
-- outer let). answerRebindRC re-points that join to the resume call site on
-- each resume so the resumed sub-run's answer goes to the right place.
-- Expected output: 210 (= 105 + 105); heap returns to baseline.
effect State s = { get : s, set : s -> () }

prog : () -> U64 with State U64
prog u =
  let a = State.get in
  let u2 = State.set (a + 100) in
  State.get

main : U64
main =
  let r = with State { var s = 5 ; get -> s ; set x k -> k x () ; v -> (v, s) } prog () in
  case r of (v, s) -> v + s
