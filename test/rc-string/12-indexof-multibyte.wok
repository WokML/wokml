module Main
import Std.Base
import Std.String

-- indexOf / indexOfFrom on multi-byte UTF-8 strings.
-- "héllo": bytes h(1) é(2=0xC3 0xA9) l(1) l(1) o(1) = 6 bytes total.
--
-- indexOf "héllo" "é"    -> Some 1 (byte offset 1)
-- indexOf "héllo" "llo"  -> Some 3 (byte offset 3; é is 2 bytes so l is at byte 3)
-- indexOf "héllo" "llo"  -> Some 3
-- indexOfFrom "héllo" "l" 4 -> Some 4 (second l is at byte 4)
-- indexOf "héllo" "z"    -> None -> 0
-- contains "héllo" "é"   -> True -> 1
-- contains "héllo" "z"   -> False -> 0
--
-- Result: 1 + 3 + 4 + 0 + 1 + 0 = 9

optionU64 : Option U64 -> U64
optionU64 o = case o of
  None   -> 0
  Some v -> v

boolU64 : Bool -> U64
boolU64 b = case b of
  True  -> 1
  False -> 0

main : U64
main =
  let a = optionU64 (indexOf "héllo" "é") in
  let b = optionU64 (indexOf "héllo" "llo") in
  let c = optionU64 (indexOfFrom "héllo" "l" 4) in
  let d = optionU64 (indexOf "héllo" "z") in
  let e = boolU64 (contains "héllo" "é") in
  let f = boolU64 (contains "héllo" "z") in
  a + b + c + d + e + f
