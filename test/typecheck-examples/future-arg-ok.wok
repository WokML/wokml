module Main
import Base
import Control
-- Carrier rule: a Suspension passed as a handle-typed argument is allowed.
-- This must NOT produce a CarrierEscape.
useIt : Suspension U64 U64 U64 (row e) -> ()
useIt s = ()
passes : Suspension U64 U64 U64 (row e) -> ()
passes s = useIt s
main : U64
main = 0
