module Main
import Std.Base
import Std.Control
-- KNOWN LEAK (resume launders effects, rung-1 boundary): TYPECHECKS today, type
-- LIES. Same handled-expression laundering as launder-leak-handled-expr, compounded
-- through NESTED handlers. `run g 0`'s residual `e` escapes both handlers' discharge
-- sites; `driveNested` declares closed yet performs `e`. Awaits rung-2 provenance.
-- See docs/superpowers/specs/2026-07-02-resume-launders-rung2-provenance.md
effect Ask = { ask : U64 }
effect Tell = { tell : U64 -> () }
driveNested : Suspension U64 U64 U64 (row e) -> U64
driveNested g = with { Ask.ask -> 0 } (with { Tell.tell x k -> k () } (run g 0))
main : U64
main = 0
