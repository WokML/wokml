module Main
import Std.Base
import Std.Control
-- KNOWN LEAK (inner-abstraction family, DEFERRED to the slice after rung 2):
-- TYPECHECKS today, the type LIES. `run h 0` performs the caller-supplied residual
-- `e`, but it sits inside a LAMBDA whose own open ambient absorbs it before it
-- reaches driver's declared-closed row -- so the caller-root rule cannot see it
-- (the lambda's residual unifies with `e` only at APPLICATION, after its body is
-- checked). Needs the inner-abstraction effect-propagation fix, NOT rung-2's
-- provenance rule. See docs/superpowers/2026-07-02-lambda-effect-laundering-note.md
driver : Suspension U64 U64 U64 (row e) -> U64
driver g = (\ h -> run h 0) g
main : U64
main = 0
