module Main
import Std.Base
import Std.Control

-- race carries Nondet (slice async-race): two identical Async children, race
-- discharges Async and adds Nondet. `useRace : () -> U64 with Nondet` witnesses
-- the residual; `main` discharges it with `runDet`.

g : () -> U64 with Async
g u = let p = Async.yield () in 1

useRace : () -> U64 with Nondet
useRace u = race g g

main : U64
main = runDet useRace
