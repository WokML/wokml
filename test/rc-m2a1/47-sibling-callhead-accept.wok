module Main
import Base

-- M2a-1 POSITIVE guard: a LetRec group sibling 'f' used ONLY as a CALL HEAD
-- ('f 3') is normal recursion / a normal in-place call, NOT an escape. The
-- generalized sibling-escape guard must NOT over-reject a call-head occurrence.
-- Must stay ACCEPTED.
mk : U64 -> U64
mk u =
  let
    f n = case n of
      0 -> u
      _ -> f (n - 1)
  in f 3

main = mk 7
