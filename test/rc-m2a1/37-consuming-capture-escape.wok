module Main
import Std.Base

-- M2a-1 reproducer #7 (ESCAPING variant of #1, must STAY rejected):
-- a LetRec group that BOTH CONSUMES (moves) an enclosing boxed capture 'b' AND
-- has a member that ESCAPES the group body (the member binder 'go' flows out as
-- the result value, not just as a call head).
--
-- 'consumingOccs' is non-empty (peek b moves b), and
-- 'letRecMemberEscapes' is true (go is returned as a value).  The dup-per-
-- consuming-use accounting is sound ONLY while the group drops as a unit at
-- scope exit; an escaped member breaks that, so this is M2a-2 territory.  The
-- boundary guard must REJECT.
data Box = Box U64

peek : Box -> U64
peek box = case box of
  Box v -> v

mk : U64 -> (U64 -> U64)
mk seed =
  let b = Box seed in
  let
    go k = case k of
      0 -> peek b
      _ -> 1 + go (k - 1)
  in go

main = (mk 6) 3
