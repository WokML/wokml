module Main
import Base

-- M2a-2 POSITIVE guard (regression for the call-head over-rejection): a recursive
-- 'LetRec' group member whose body CALLS an enclosing boxed CAPTURE 'g' as a
-- (saturated) call HEAD ('g k'). A call head is a BORROW under uniform
-- borrow-on-call, NOT a move/consume, so the group must be ADMITTED at the RC
-- boundary and run SOUND. The result is a U64 scalar (non-escaping), so the only
-- thing keeping it out before the fix was 'consumingOccs' counting the call head.
add1 : U64 -> U64
add1 x = x + 1

mk : U64 -> U64
mk u =
  let g = add1 in
  let
    go k = case k of
      0 -> g u
      _ -> 1 + go (k - 1)
  in go 3

main = mk 6
