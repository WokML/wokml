module Main
import Base

-- M2a-2 POSITIVE guard (PARTIAL-application variant of #52): a recursive 'LetRec'
-- group member whose body uses an enclosing boxed CAPTURE 'g' as a PARTIAL call
-- HEAD ('g k' where 'g' wants two args). A partial call head is still a BORROW
-- under uniform borrow-on-call, NOT a move, so the group must be ADMITTED and run
-- SOUND. The result is a U64 scalar (non-escaping).
addp : U64 -> U64 -> U64
addp a b = a + b

mk : U64 -> U64
mk u =
  let g = addp in
  let
    go k = case k of
      0 -> (g u) 1
      _ -> 1 + go (k - 1)
  in go 3

main = mk 6
