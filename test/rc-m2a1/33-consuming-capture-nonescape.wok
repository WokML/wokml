module Main
import Base

-- M2a-1 reproducer #1: a LetRec member that CONSUMES (moves) an enclosing
-- boxed capture.  The group is non-escaping (result is a U64 scalar).
--
-- 'letRecMemberConsumesCaptureNonEscaping' detects this: 'peek b' inside 'go' is
-- an 'RApp' with 'b' as an argument, so 'b' appears in a consuming position.
-- 'firstOrderNoHandlerViolations' must return a non-empty list (currently
-- rejected).  Task M2a-1 Task 3 will lift this restriction by inserting a
-- dup-per-consuming-use in place of the bare borrow.
data Box = Box U64

peek : Box -> U64
peek box = case box of
  Box v -> v

main =
  let b = Box 6 in
  let
    go k = case k of
      0 -> peek b
      _ -> 1 + go (k - 1)
  in go 3
