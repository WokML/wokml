module Main
import Base
import String

-- Codepoint-boundary check in decodeCharAt: "café" (UTF-8: 63 61 66
-- C3 A9) has byteLength 5, so offset 4 is in bounds. However byte 4 is
-- 0xA9, the continuation byte of the 2-byte sequence C3 A9 encoding U+00E9
-- (e with acute). Decoding from a continuation byte is ill-formed; utf8Width
-- fires the codepoint-boundary check rather than the out-of-bounds guard.
-- Both interpreters must raise a PrimError.
main : Char
main = decodeCharAt "café" 4
