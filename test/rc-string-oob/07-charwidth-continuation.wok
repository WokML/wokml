module Main
import Std.Base
import Std.String

-- Continuation-byte check in charWidthAt: byte 4 of "café" (UTF-8:
-- 63 61 66 C3 A9, byteLength=5) is 0xA9, the continuation byte of the
-- 2-byte sequence C3 A9 (U+00E9). Offset 4 is in bounds, but utf8Width
-- fires the codepoint-boundary check on seeing a continuation byte.
-- Mirrors 06-decode-continuation but exercises charWidthAt's own guard.
-- Both interpreters must raise a PrimError.
main : U64
main = charWidthAt "café" 4
