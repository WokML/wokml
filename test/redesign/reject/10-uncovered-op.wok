-- v2 FINAL surface REJECT. The D14 coverage law: the clauses for an op must
-- cover its argument type. Under labels a perform routes to exactly ONE
-- activation, so a match failure has nowhere to fall through to.
module Main
import Base

type Msg = Ping U64 | Close

effect Proto
  req : Msg -> U64

partial : Handler Proto a a
partial = handler Proto
  req (Ping n), k -> k n
-- EXPECT: E-COVER clauses for op `req` do not cover `Msg`: missing `Close`
--         note: performs route to exactly one activation; there is no
--         fallthrough handler under labels

main : U64
main = handle partial in Proto.req Close
