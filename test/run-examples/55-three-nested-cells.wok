module Main
import Std.Base
import Std.Control

-- Three-plus nested distinct cells route apart. Three independent State U64
-- cells (`a`, `b`, `c`), all minted by the one `state` runner, are read in one
-- tuple. Routing follows the names, so each `.get` reads its own seed:
-- (a.get, b.get, c.get) = (1, 2, 3). The three nested runners wrap the result
-- innermost-first, so main is ((((1, 2, 3), 3), 2), 1).
read3 : State U64 -> State U64 -> State U64 -> (U64, U64, U64)
read3 a b c = (a.get, b.get, c.get)

main : ((((U64, U64, U64), U64), U64), U64)
main = with a = state 1 in with b = state 2 in with c = state 3 in read3 a b c
