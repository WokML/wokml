module Main
import Std.Base
import Std.Control
worker : U64 -> () -> U64 with Coro U64 U64
worker n u = (Coro.suspend n) * 2
main : U64
main =
  case start (worker 10) of
    Completed _    -> 0
    Suspended xa ga ->
      case start (worker 20) of
        Completed _    -> 0
        Suspended xb gb -> run gb (xb + 1) + run ga (xa + (xa - 9))
