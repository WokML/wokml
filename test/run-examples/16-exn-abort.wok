module Main
import Base

effect Exn = { throw : String -> Never }

risky : Bool -> U64 with Exn
risky b = if b then Exn.throw "boom" else 7

-- Reshaping handler: the computation's value type (U64) differs from the
-- handler's answer type (Option U64), so a value arm is required. The throw
-- arm aborts (binds k, never resumes -- exempt from the forgotten-resume lint
-- because `throw`'s result is `Never`).
main : Option U64
main =
  with { once Exn.throw msg k -> None
         ; return v -> Some v }
  risky True
