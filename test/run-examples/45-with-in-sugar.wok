module Main
import Base

effect State s = { get : s, set : s -> () }

state : s -> (() -> a with State s + eff e) -> (a, s) with eff e
state i c = with State { var s = i ; get -> s ; set x k -> k x () ; v -> (v, s) } c ()

main : (U64, U64)
main =
  with state 100 in
  let a = State.get in
  let b = State.set (a + 5) in
  State.get
