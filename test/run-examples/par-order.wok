module Main
import Base
import Control

-- Order-observable determinism fixture for `par` (slice async-par).
--
-- genP tells 1 (before its yield) and 3 (after); genQ tells 2 and 4.
-- Correct lockstep interleave => marks fire in the order 1,2,3,4.
-- A sequential (non-interleaved) driver would fire 1,3,2,4 instead.
-- The `writer` log records the actual firing order; we fold it into a
-- base-10 number so the `--run` value IS the interleave order (1234 vs 1324).

genP : () -> U64 with Async + Writer [U64]
genP u = let a = Writer.tell [1] in let b = Async.yield () in let c = Writer.tell [3] in 0

genQ : () -> U64 with Async + Writer [U64]
genQ u = let a = Writer.tell [2] in let b = Async.yield () in let c = Writer.tell [4] in 0

-- Route `par` through an intermediate function with an explicit Writer residual
-- (mirrors par-residual-log's `useE`); this is what the proven fixtures do.
runPar : () -> (U64, U64) with Writer [U64]
runPar u = par genP genQ

-- Fold the recorded order into a base-10 number: [1,2,3,4] => 1234.
toNum : U64 -> [U64] -> U64
toNum acc xs = case xs of
  []        -> acc
  n :: rest -> toNum (acc * 10 + n) rest

main : U64
main = case writer (\u -> runPar ()) of
  (_, log) -> toNum 0 log
