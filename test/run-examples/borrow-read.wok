module Main
import Base
import Borrow

-- FFI Slice 3 Task 3: the Borrow read surface (length/byteAt/slice/memchr)
-- plus the Bytes.copy escape hatch, exercised via the transitional
-- __borrow_demo producer (a static deterministic buffer, buf[i] = i & 0xFF).
-- No Bytes import: Borrow and Bytes both define `length`, which
-- would clash if both were imported into the same module (the known
-- cross-module name-collision constraint -- see the String/Bytes corpus
-- comments in test/Spec.hs). `eqBytes` lives in Base, so `copy`'s result
-- can still be checked without it.
--
-- b = __borrow_demo 8 -> [0,1,2,3,4,5,6,7]
-- n    = length b           = 8
-- b0   = byteAt b 0         = 0
-- b7   = byteAt b 7         = 7
-- s    = slice b 2 6        = [2,3,4,5]
-- sLen = length s           = 4
-- s0   = byteAt s 0         = 2
-- s3   = byteAt s 3         = 5
-- memchr b 5  = Some 5  (b[5] == 5)
-- memchr s 5  = Some 3  (s[3] == 5)
-- memchr b 99 = None    (no byte 99 in a buffer of 0..7)
-- c  = copy b              (an owned Bytes, equal to a second independent
-- c2 = copy (__borrow_demo 8)   borrow over the same deterministic pattern)
-- eqOk = if eqBytes c c2 then 1 else 0  = 1
--
-- Total: 8 + 0 + 7 + 4 + 2 + 5 + 5 + 3 + 1 = 35
main : U64
main =
  let b = __borrow_demo 8 in
  let n = length b in
  let b0 = byteAt b 0 in
  let b7 = byteAt b 7 in
  let s = slice b 2 6 in
  let sLen = length s in
  let s0 = byteAt s 0 in
  let s3 = byteAt s 3 in
  let c = copy b in
  let c2 = copy (__borrow_demo 8) in
  let eqOk = if eqBytes c c2 then 1 else 0 in
  case memchr b 5 of
    Some off -> case memchr s 5 of
      Some soff -> case memchr b 99 of
        None -> n + b0 + b7 + sLen + s0 + s3 + off + soff + eqOk
        Some _ -> 0
      None -> 0
    None -> 0
