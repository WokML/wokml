origin =
  let t : Point = Point { x = 0, y = 0 }
  t

getX p : Point =
  let t : U64 = p.x
  t

getY p : Point =
  let t : U64 = p.y
  t

moveBy dx : U64 dy : U64 p : Point =
  let t.1 : U64 = p.x
  let t.2 : U64 = +(t.1, dx)
  let t.3 : U64 = p.y
  let t.4 : U64 = +(t.3, dy)
  let t.5 : Point = Point { x = t.2, y = t.4 }
  t.5
