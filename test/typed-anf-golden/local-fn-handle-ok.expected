pure_local =
  letrec
    dbl : U64 x : U64 =
      let t.2 : U64 = +(x, x)
      t.2
  let t.1 : U64 = dbl(3)
  t.1

inscope =
  let t.3 : TcHandler "State" U64 () ((), U64) = state(0)
  install t.3 in
  letrec
    bump : () x : U64 =
      let t.2 : () = c.State.set(x)
      t.2
  let t.1 : () = bump(7)
  t.1

main =
  inscope
