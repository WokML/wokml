producer u : () =
  let t.5 : U64 = Coro.suspend(7)
  let x : U64 = t.5
  let t.4 : () = Log.emit(x)
  let v : () = t.4
  let t.3 : U64 = Tick.tick()
  let t.1 : U64 = t.3
  let t.2 : U64 = +(x, t.1)
  t.2

drive u : () =
  let t.1 : Step U64 U64 U64 {Log, Tick} = start(producer)
  case t.1 of
    Completed r : U64 -> r
    Suspended _ : U64 g : Suspension U64 U64 U64 {Log, Tick} ->
      let t.2 : U64 = run(g, 5)
      t.2
  with {
    return v.1 : U64 -> v.1
    Log.emit(n : U64, resume.1 : U64) ->
      let t.3 : U64 = resume.1(())
      t.3
  }
  with {
    return v.2 : U64 -> v.2
    Tick.tick(resume.2 : U64) ->
      let t.4 : U64 = resume.2(1)
      t.4
  }

main =
  let t : U64 = drive(())
  t
