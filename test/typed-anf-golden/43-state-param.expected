runState i : a0 c : () -> a1 =
  let s : a0 = i
  let t.1 : a1 = c(())
  t.1
  with {
    return v : a1 ->
      let t.3 : (a1, a0) = Tuple2(v, s)
      t.3
    State.get(resume.1 : a0 -> a0 -> (a1, a0)) ->
      let res : a0 = resume.1(s, s)
      res
    State.set(x : a0, resume.2 : a0 -> () -> (a1, a0)) ->
      let t.2 : (a1, a0) = resume.2(x, ())
      t.2
  }

prog u : () =
  let t.3 : U64 = State.get()
  let a : U64 = t.3
  let t.1 : U64 = +(a, 1)
  let t.2 : () = State.set(t.1)
  t.2

main =
  let t : ((), U64) = runState(0, prog)
  t
