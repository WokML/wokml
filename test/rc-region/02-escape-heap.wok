module Main
import Std.Base

-- Heap routing (negative control for arena routing): the Pair IS the return
-- value of 'makePair', so it ESCAPES -- it must be born counted (Heap).
-- Expected: arena_bytes == 0 throughout (no arena allocation); counted allocs
-- match exactly one Pair cell; abstract == C on all stats.

data Pair = Pair U64 U64

makePair : U64 -> U64 -> Pair
makePair x y = Pair x y

firstOf : Pair -> U64
firstOf p = case p of Pair a _ -> a

main = firstOf (makePair 10 20)
