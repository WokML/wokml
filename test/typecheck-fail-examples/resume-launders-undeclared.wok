module Main
import Base
import Control
-- DEATH TEST (Option B, resume launders effects): a resume driver that performs
-- the parked tail's effects via `run` but declares no `with eff e` is rejected
-- with UndischargedEffect. Single consumption -> no carrier/affine error masks it.
drive : Suspension U64 U64 U64 (row e) -> U64
drive g = run g 0
main : U64
main = 0
