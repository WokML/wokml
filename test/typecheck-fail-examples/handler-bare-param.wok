module Main
import Std.Base

-- The bare `s = i` handler-state form is rejected; it must be `var s = i`.
effect State s = { get : s, set : s -> () }
state : s -> (State s -> a) -> (a, s)
state i c = with self = State { s = i ; get -> s ; set x k -> k x () ; v -> (v, s) } in c self

main : U64
main = 0
