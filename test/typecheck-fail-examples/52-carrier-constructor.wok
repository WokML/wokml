module Main
import Base

-- Carrier rule: storing a handle inside a data constructor lets it escape. The
-- argument of `Some` is a polymorphic slot (`a`), not a handle slot, so the
-- handle escaping into it is rejected.
effect State s = { get : s, set : s -> () }
state : s -> (State s -> a) -> a
state i c = with self = State { var s = i ; get -> s ; once set x k -> k x () ; return v -> v } in c self

boxed = with count = state 0 in Some count
