module Main
import Std.Base
import Std.Control
-- C1: a Future consumed through a HELPER call escapes the intra-procedural
-- affine check. `useit` resumes its Future parameter; calling it twice on the
-- same future double-resumes. The fix counts a Future passed to ANY function
-- (except the `value` reader) as a consumption, so `useit s + useit s` = Many.
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1
useit : Future U64 U64 U64 -> U64
useit f = resume f 1
main : U64
main =
  let s = start producer in
  useit s + useit s
