module Main
import Std.Base
import Std.Control
-- The producer performs an unhandled effect (Log) alongside Coro. `start` only
-- installs the Coro handler, so the residual Log row is unhandled => RowMismatch.
effect Log = { emit : U64 -> () }
producer : () -> U64 with Coro U64 U64 + Log
producer u = let x = Coro.suspend 42 in let v = Log.emit x in x
main : Step U64 U64 U64
main = start producer
