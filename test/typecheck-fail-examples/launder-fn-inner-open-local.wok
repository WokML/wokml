module Main
import Std.Base
import Std.Control
-- The inner local `go` opens its OWN unrelated channel `f`, not the outer
-- trapped `e` from `g`; the outer sig still has no channel for e. Expect
-- UndischargedEffect.
drive : Suspension U64 U64 U64 (row e) -> U64
drive g = let go : () -> U64 with eff f
              go u = run g 0
          in go ()
main : U64
main = 0
