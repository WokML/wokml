module Main
import Std.Base
import Std.Control
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1
-- A LOCAL `let value` shadow is a CONSUMING helper, not the prelude reader.
-- The free-occurrence whitelist must NOT treat it as non-consuming, so the two
-- `value s` calls double-consume the future. Expect FutureConsumedTwice.
main : U64
main =
  let s = start producer in
  let value = \f -> __coro_unwrap (__coro_resume f 1) in
  value s + value s
