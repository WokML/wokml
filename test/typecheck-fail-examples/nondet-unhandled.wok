module Main
import Std.Base
import Std.Control

-- Unhandled Nondet (slice async-race): `race` adds the Nondet marker, but `solo`
-- is annotated pure (no `with`). Without a `runDet` (or other Nondet handler) the
-- residual Nondet is undischarged => type error.

g : () -> U64 with Async
g u = let p = Async.yield () in 1

solo : () -> U64
solo u = race g g
