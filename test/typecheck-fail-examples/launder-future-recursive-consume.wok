module Main
import Std.Base
import Std.Control
-- Closed-sig leaking form pinned after future-recursive-consume was
-- reclassified to trip the double-consume check via `with eff e` on both
-- `loop` and `bad`: with the channels removed, the laundering check fires
-- first. Expect UndischargedEffect.
loop : U64 -> Suspension U64 U64 U64 (row e) -> U64
loop n f =
  case eqU64 n 0 of
    True -> 0
    False -> run f 1 + loop (n - 1) f
bad : Step U64 U64 U64 (row e) -> U64
bad s = case s of
  Completed r   -> r
  Suspended x g -> loop 3 g
main : U64
main = 0
