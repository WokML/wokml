module Main
import Std.Base
import Std.Control
-- A user may now DEFINE a top-level `value` (the reservation is gone). But it is
-- a regular, non-extern binding, NOT the prelude extern reader — so the affine
-- check does NOT trust it: it is treated as a consumer. This `value` consumes
-- (resume-equivalent), and `main` calls it twice on the same future, so the
-- future is consumed twice. Expect FutureConsumedTwice (NOT ReservedName: the
-- declaration site is allowed; the double-consume is what fails).
value : Future U64 U64 U64 -> U64
value s = __coro_unwrap (__coro_resume s 1)
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1
main : U64
main =
  let s = start producer in
  value s + value s
