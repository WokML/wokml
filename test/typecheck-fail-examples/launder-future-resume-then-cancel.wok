module Main
import Base
import Control
-- Closed-sig leaking form pinned after future-resume-then-cancel was
-- reclassified to trip the double-consume check via `with eff e`: with the
-- channel removed, `bad`'s own sig has no channel for e, so the laundering
-- check fires first. Expect UndischargedEffect.
bad : Step U64 U64 U64 (row e) -> U64
bad s = case s of
  Completed r   -> r
  Suspended x g -> let u = cancel g in run g 1
main : U64
main = 0
