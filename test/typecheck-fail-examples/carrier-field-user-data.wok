module Main
import Base
import Control
-- Containment (spec 2026-08-10): a user type whose field is DECLARED at
-- carrier type is itself a carrier, so it cannot escape its activation.
-- Before the containment closure this was the laundering hole: `[g]` was
-- rejected but `[Box g]` was accepted, because a precisely-typed constructor
-- slot is indistinguishable from `step`/`run`'s legitimate parameter. The more
-- precisely the field was typed, the more it laundered.
data Box (row e) = Box (Suspension U64 U64 U64 (row e))
grab : Step U64 U64 U64 (row e) -> [Box (row e)]
grab s = case s of
  Completed _   -> []
  Suspended x g -> [Box g]
main : U64
main = 0
