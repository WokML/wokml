module Main
import Std.Base
import Std.Control

-- Regression: the payload restriction (spec 3.3) walks constructor fields
-- TRANSITIVELY. Box2 wraps Box wraps a function; Promise Box2 would smuggle
-- the closure across the carrier through two layers of wrapping.

data Box = Box (() -> U64)
data Box2 = Box2 Box

bad : Promise Box2 -> U64
bad p = 0

main : U64
main = 0
