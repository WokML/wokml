module Main
import Std.Base
import Std.Control
-- DEATH TEST (inner-abstraction family, rung 3): REJECTED with UndischargedEffect.
-- `helper` is a POINT-FREE 0-arg binding whose body is a lambda performing the
-- caller-supplied residual `e`. It is now REJECTED, eta-consistent with the
-- explicit-param form `helper g = run g 0`. Rung 3 checks the lambda body against
-- the declared sig (CHECKING MODE): the lambda's param `g` is refined from the
-- sig's `Suspension ... (row e)` and, because the sig's arrow is CLOSED, that
-- param's row var `e` becomes a caller-root -- so `run g 0` rejects at the perform
-- site. See docs/superpowers/specs/2026-07-03-inner-abstraction-effect-laundering-design.md
helper : Suspension U64 U64 U64 (row e) -> U64
helper = \ g -> run g 0
main : U64
main = 0
