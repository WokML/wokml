module Main
import Base
import Borrow

-- Borrow is second-class: a closure that CAPTURES a Borrow and then ESCAPES
-- (here it is returned) is rejected -- the Borrow would outlive its scope
-- through the closure. `\x -> byteAt b x` captures `b`; returning it would let
-- the foreign buffer be read after its lending scope is gone.
h : Borrow -> (U64 -> U64)
h b = \x -> byteAt b x
