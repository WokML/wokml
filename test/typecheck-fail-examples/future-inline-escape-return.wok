module Main
import Std.Base
import Std.Control
-- Carrier rule: an inline-produced Future (not let-bound) returned directly
-- must be rejected with CarrierEscape.
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1
leak : () -> Future U64 U64 U64
leak _ = start producer
main : U64
main = 0
