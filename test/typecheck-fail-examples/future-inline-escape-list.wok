module Main
import Std.Base
import Std.Control
-- Carrier rule: an inline-produced Future (not let-bound) stored in a list
-- must be rejected with CarrierEscape.
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1
leakList : () -> [Future U64 U64 U64]
leakList _ = [start producer]
main : U64
main = 0
