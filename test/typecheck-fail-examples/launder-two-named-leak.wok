module Main
import Std.Base
import Std.Control
-- A function performs a TRAPPED effect e (from a Suspension (row e) param,
-- via `run`) while its own signature declares only a DIFFERENT named-effect
-- channel (State U64), not `eff e`. The declared channel does not discharge
-- the trapped row. Expect UndischargedEffect.
bad : Suspension U64 U64 U64 (row e) -> U64 with State U64
bad g = run g 0
main : U64
main = 0
