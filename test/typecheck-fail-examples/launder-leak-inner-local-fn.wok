module Main
import Std.Base
import Std.Control
-- DEATH TEST (inner-abstraction family, rung 3): REJECTED with UndischargedEffect.
-- `run g 0` performs the OUTER caller-root residual `e` (captured `g`) inside a
-- SIGLESS LOCAL FUNCTION `go`. Rung 3 makes an inner abstraction INHERIT the
-- enclosing caller-roots instead of resetting them, so `go`'s body sees `e` as a
-- root and rejects at the perform site. See
-- docs/superpowers/specs/2026-07-03-inner-abstraction-effect-laundering-design.md
drive : Suspension U64 U64 U64 (row e) -> U64
drive g = let go u = run g 0 in go ()
main : U64
main = 0
