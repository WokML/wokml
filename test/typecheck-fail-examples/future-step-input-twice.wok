module Main
import Std.Base
import Std.Control
-- The input future `s` is passed to TWO `step` calls => consumed twice.
producer : () -> () with Coro U64 ()
producer u = let z = Coro.suspend 1 in ()
twice : Future U64 () () -> U64
twice s = step s () (\r -> 0) (\x s' -> x)
        + step s () (\r -> 0) (\x s' -> x)
main : U64
main = let s = start producer in twice s
