module Main
import Base
import Control
-- C1: a Suspension extracted from a Suspended arm is consumed twice (two `run`
-- calls on the same `g`) => Many. Expect FutureConsumedTwice.
bad : Step U64 U64 U64 (row e) -> U64 with eff e
bad s = case s of
  Completed r   -> r
  Suspended x g -> run g 1 + run g 2
main : U64
main = 0
