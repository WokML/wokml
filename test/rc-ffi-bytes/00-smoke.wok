module Main
import Std.Base
import Std.Bytes

-- both producers yield 5 deterministic ASCII bytes (0..4); fromBytes accepts
-- them (valid UTF-8 control chars); length returns 5
main : U64
main =
  case fromBytes (__ffi_demo_copy 5) of
    Some _ -> case fromBytes (__ffi_demo_adopt 5) of
      Some _ -> length (__ffi_demo_adopt 5)
      None   -> 0
    None -> 0
