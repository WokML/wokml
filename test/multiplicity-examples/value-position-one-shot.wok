module Main
import Base

-- VALUE-POSITION (non-tail) handler: its result is consumed by the enclosing
-- `case`, so `hAnswerJoin = Just j`. The `tick` arm resumes its continuation
-- exactly once, so the one-shot check must certify it `1` -- NOT `ω`. The arm
-- delivers via `jump j` (an exit that contributes zero resume-uses); before the
-- fix that exit jump was falsely charged `ω`.
effect Tick = { tick : U64 -> U64 }

useTick : () -> U64 with Tick
useTick u = Tick.tick 41

main : U64
main =
  let r = (with { Tick.tick x k -> k (x + 1) } useTick ()) in
  case r of
    0 -> 0
    _ -> r
