module Main
import Base
import Control

-- M3-a: store the continuation in ONE branch xor the other. Each branch hands
-- `k` to `__cont_store` at most once, so the branch-join (`joinC`) keeps the arm
-- at `1` (not `ω`): only one path runs.
effect Park = { park : U64 -> U64 }

usePark : () -> U64 with Park
usePark u = Park.park 7

main : U64
main =
  let cell = __cont_cell_new () in
  with { Park.park x k -> case x of
           0 -> let a = __cont_store cell k in 0
           _ -> let b = __cont_store cell k in 1 }
  usePark ()
