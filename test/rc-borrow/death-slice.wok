module Main
import Base
import Borrow

-- DEATH TEST (FFI Slice 3 Task 6, SLICE-escape route). `slice` returns a derived
-- Borrow viewing the SAME malloc'd buffer, so it is just as second-class as the
-- parent. `leak` returns the slice, escaping its lending activation. Normal build:
-- compile-time CarrierEscape. Under the `ffi-borrow-noescape-negctrl` mutation it
-- runs: the activation-scoped close frees the ONE base buffer when `leak` returns
-- (the slice shares it, registers nothing), and `main`'s C-side `memchr` scan of
-- the escaped slice hits the freed base buffer -> ASan read-after-free. (`memchr`,
-- not `byteAt`: the C `c_memchr` load is ASan-instrumented; `peekElemOff` is not.)
leak n =
  let b = Demo.lendBuffer n in
  slice b 0 4

main =
  let s = leak 8 in
  case memchr s 3 of
    Some o -> o
    None   -> 99
