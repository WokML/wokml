module Main
import Std.Base
import Std.Borrow

-- __borrow_demo 10 yields buf = [0,...,9]. slice b 3 8 = [3,4,5,6,7]
-- (parent offset 3, length 5). memchr for byte 6 hits at the SLICE-RELATIVE
-- offset 3 (parent index 6 minus slice start 3), exercising both the CHeap
-- slice path (borrowSliceRC) and the libc memchr scan over a derived view.
main : U64
main =
  case memchr (slice (__borrow_demo 10) 3 8) 6 of
    Some i -> i
    None   -> 999
