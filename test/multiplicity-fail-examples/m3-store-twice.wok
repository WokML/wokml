module Main
import Base
import Control

-- M3-a (fail): storing the continuation into TWO cells in sequence consumes it
-- twice. Each `__cont_store` is `1`; `addC One One = Many`, so the arm is `ω`
-- and the one-shot law rejects it (store-twice = a provable double-resume).
effect Park = { park : U64 -> U64 }

usePark : () -> U64 with Park
usePark u = Park.park 7

main : U64
main =
  let cellA = __cont_cell_new () in
  let cellB = __cont_cell_new () in
  with { Park.park x k -> let a = __cont_store cellA k in let b = __cont_store cellB k in 0 }
  usePark ()
