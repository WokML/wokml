module Main
import Std.Base

-- A single-member recursive group closing over an enclosing boxed local `b`.
-- The group is non-escaping (it computes a U64; the member is only called),
-- so it is covered and runs under the Phase 2 borrow model.
data Box = Box U64

main =
  let b = Box 6 in
  let
    go k = case k of
      0 -> case b of
             Box v -> v
      _ -> 1 + go (k - 1)
  in go 3
