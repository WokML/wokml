module Main
import Std.Base

mapOption : (a -> b) -> Option a -> Option b
mapOption f m = case m of
  None   -> None
  Some x -> Some (f x)

fromOption : a -> Option a -> a
fromOption def m = case m of
  None   -> def
  Some x -> x

headList : [a] -> Option a
headList xs = case xs of
  []     -> None
  h :: _ -> Some h
