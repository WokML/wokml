data Maybe a = Nothing | Just a
data List a = Nil | Cons a (List a)

id : a -> a
id x = x

const : a -> b -> a
const x y = x

mapMaybe : (a -> b) -> Maybe a -> Maybe b
mapMaybe f m = case m of
  Nothing -> Nothing
  Just x  -> Just (f x)

fromMaybe : a -> Maybe a -> a
fromMaybe def m = case m of
  Nothing -> def
  Just x  -> x

headList : List a -> Maybe a
headList xs = case xs of
  Nil      -> Nothing
  Cons h _ -> Just h
