-- USE CASE: one-shot escaping coroutine (second-class affine Future).
-- A producer runs to its first `Coro.suspend`, parking its continuation
-- below the effect boundary. The driver holds only an opaque Future handle
-- (second-class via the carrier rule: can't be returned, stored, or listed).
-- `resume` consumes the Future exactly once (affine: resume XOR cancel, at
-- most once total). `value` reads the yielded value without consuming the Future.
-- The parked continuation lives in the runtime; re-establishing the Coro handler
-- on resume is done automatically by deep re-install.
--
-- Surface: plain functions, no `with coro in` needed.
--   `start producer` -- installs Coro, runs to first suspend, returns Future
--   `value s`        -- non-consuming read of the yielded value
--   `resume s v`     -- consuming: resumes the parked continuation with v
--   `cancel s`       -- the other consuming eliminator (resume XOR cancel)
--
-- The Future is second-class and affine: a compile error if resumed twice,
-- returned from a function, put in a list, or stored in a constructor.
module Main
import Std.Base
import Std.Control

-- Producer: suspends with 42; when resumed with v, returns v + 1.
producer : () -> U64 with Coro U64 U64
producer _ = (Coro.suspend 42) + 1

-- Driver: runs the producer to its first suspension, then resumes it with
-- value * 10 (= 420). The producer finishes as 420 + 1 = 421.
main : U64
main =
  let s = start producer in
  resume s (value s * 10)
