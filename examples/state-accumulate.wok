-- A stateful fold: walk a list RECURSIVELY, accumulating a running total in the
-- State effect. The `state` runner hands back a (value, finalState) pair; we use
-- a tuple destructuring `let` to keep just the part we want -- no `fst` needed.
module Main
import Std.Base
import Std.Control

-- Add every element of the list into the State total, one recursive step each.
sumList : [U64] -> () with State U64
sumList xs = case xs of
  []      -> ()
  y :: ys -> let cur = State.get in
             let u   = State.set (cur + y) in
             sumList ys

-- `state 0 comp` runs `comp` with initial state 0 and returns ((), finalTotal).
-- The destructuring `let (_, total) = ... in total` projects out the total.
main : U64
main =
  let (result, total) = state 0 (\u -> sumList [3, 1, 4, 1, 5, 9, 2, 6]) in
  total
