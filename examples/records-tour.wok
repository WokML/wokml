module Main
import Std.Base

-- Single-constructor record decl (named constructor form).
data Point = Point { x : U64, y : U64 }

-- Single-constructor with elided constructor name (sugar: constructor
-- name defaults to the type name).
data User = {
  name : String
  age : U64
}

-- Polymorphic record declaration: Container a holds a value of type a.
-- Construction works for any a; field access via dot only works for
-- zero-arity (non-parameterised) record types in v1.
data Container a = Container { value : a }

-- Multi-constructor decl with per-constructor record fields.
data Shape
  = Circle { radius : U64 }
  | Square { side : U64 }
  | Rect { width : U64, height : U64 }

-- Construction: closed Point.
origin : Point
origin = Point { x = 0, y = 0 }

-- Construction: extension via sig (extra field score allowed by sig).
named : Point + { score : U64 }
named = Point { x = 0, y = 0, score = 99 }

-- Row-polymorphic spread: preserve extra fields unchanged.
preserveExtras : Point + row r -> Point + row r
preserveExtras p = Point { ..p }

-- Row-polymorphic spread with field override.
flipXY : Point + row r -> Point + row r
flipXY p = Point { ..p, x = p.y, y = p.x }

-- Field access on closed record.
getX : Point -> U64
getX p = p.x

-- Field access on row-polymorphic record (declared field is always accessible).
getXOpen : Point + row r -> U64
getXOpen p = p.x

-- Strict pattern: matches only exact Point (x and y, no extras allowed).
sumCoords : Point -> U64
sumCoords p = case p of
  Point { x = 0, y = 0 } -> 0
  Point { x = a, y = b } -> a + b

-- Open pattern: matches Point extended with any additional fields.
sumCoordsAny : Point + row r -> U64
sumCoordsAny p = case p of
  Point { x = a, y = b, .. } -> a + b

-- Multi-constructor record construction: each constructor produces its own
-- record-tagged type (Circle { ... }, Square { ... }, etc.).
unitCircle = Circle { radius = 1 }
unitSquare = Square { side = 1 }

-- Field access on each constructor's record type.
circleRadius = unitCircle.radius

-- Nominal safety: UserId and OrderId are distinct even though both
-- wrap a single U64 field named value.
data UserId = UserId { value : U64 }
data OrderId = OrderId { value : U64 }

userId : UserId -> U64
userId u = u.value

orderId : OrderId -> U64
orderId o = o.value
