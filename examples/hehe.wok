-- examples/hehe.wok
-- A guided tour of wok v1 syntax: every grammar production exercised once.
-- See ../README.md for known warts. Parse with:
--   cabal run wok -- examples/hehe.wok

{-
   Block comments use BNFC's standard non-nesting form.
   Use line comments for anything that mentions block-comment delimiters.
-}

module Main
import Std.Base

----------------------------------------------------------------------
-- 1. Fixity declarations (relational precedence, no numeric levels)
--    The common operators (+, -, *, /, ==, /=, &&, ||, ++, $) come from
--    Std.Base. Operators NOT in Std.Base get a bare fixity here.
--    Note: the neighbor check (`tighter than X`) runs on the module's
--    OWN table, so we can only relate to operators declared here.
----------------------------------------------------------------------

fixity ^   right
fixity div left
fixity mod left

----------------------------------------------------------------------
-- 2. Algebraic data types
--    Bool / Option / Result are provided by Std.Base; [] is built-in.
--    We keep Tree and Pair as examples of user-defined types.
----------------------------------------------------------------------

data Tree a = Leaf | Node (Tree a) a (Tree a)
data Pair a b = MkPair a b

----------------------------------------------------------------------
-- 3. Type signatures and prefix function definitions
----------------------------------------------------------------------

-- Multi-name signature: one type, many names
zero, one, two : U64
zero = 0
one = 1
two = 2

-- Curried function type (right-associative arrow)
add : U64 -> U64 -> U64
add x y = x + y

-- Higher-order function type with parens
twice : (a -> a) -> a -> a
twice f x = f (f x)

-- Function returning a tuple type
swap : (a, b) -> (b, a)
swap p = case p of
  (x, y) -> (y, x)

-- Function on list type
sumList : [U64] -> U64
sumList xs = case xs of { [] -> 0; _ -> 1 }

-- Nested type constructor application (List a -> Option a)
headOption : [a] -> Option a
headOption xs = case xs of
  []     -> None
  x :: _ -> Some x

-- Polymorphic deconstruction
result' : (a -> c) -> (b -> c) -> Result a b -> c
result' f g e = case e of
  Ok a  -> f a
  Err b -> g b

----------------------------------------------------------------------
-- 4. Expressions: application, infix chains, atoms
----------------------------------------------------------------------

-- Left-associative juxtaposition application
applyTwice f x = f (f x)

-- Flat infix chain (resolved by Std.Base's fixity table: * and / are
-- tighter than +, so this parses as a + (b * c) + (a / b)).
formula a b c = a + b * c + a / b

-- Backtick infix usage of an alphabetic name
modSeven n = n `mod` 7

-- Operator as a value via parens
plusFn = (+)

-- List literal
oneToThree = [1, 2, 3]

-- Empty list
nilList = []

-- Paren-wrapped expression (NOT a tuple - single element)
parenOne = (42)

-- 2-tuple and 3-tuple
twoPair = (1, "x")
threeTuple = (1, 2, 3)

----------------------------------------------------------------------
-- 5. Lambda, let-in, case-of, if-then-else
----------------------------------------------------------------------

-- Single-arg lambda
constant = \x -> 42

-- Multi-arg lambda
project = \x y -> x

-- Let with single binding (layout)
inc x =
  let y = x + 1
  in y

-- Let with multiple bindings (layout)
quadratic x =
  let
    a = 2
    b = 3
    c = 5
  in a * x * x + b * x + c

-- Case-of with multiple alternatives (layout)
describe n =
  case n of
    0 -> "zero"
    1 -> "one"
    _ -> "many"

-- Built-in if/then/else (not mixfix)
select b = if b then "yes" else "no"

-- Lambda body containing let
withLet = \x ->
  let doubled = x + x
  in doubled

----------------------------------------------------------------------
-- 6. Patterns: variables, wildcards, literals, constructors, cons, tuples, lists
----------------------------------------------------------------------

-- Variable pattern
identity x = x

-- Wildcard pattern
ignore _ = 0

-- Literal patterns
isZero n = case n of
  0 -> True
  _ -> False

-- Constructor pattern (PApp with 1+ args; nullary like None parses as PAtom APVar)
extract m = case m of
  Some x -> x
  None   -> 0

-- Cons pattern (right-associative)
firstTwo xs = case xs of
  a :: b :: _ -> (a, b)
  _           -> (0, 0)

-- Tuple pattern
fst' p = case p of
  (a, b) -> a

-- Three-tuple pattern
thirdOf p = case p of
  (_, _, c) -> c

-- Multiple list-literal alternatives need explicit braces (documented layout wart)
classify xs = case xs of { [] -> "empty"; [_] -> "single"; _ -> "many" }

-- Constructor-in-cons pattern requires parens around inner application
unwrapHead xs = case xs of
  (Some x) :: _ -> x
  _             -> 0

-- String / char literal patterns
greet name = case name of
  "" -> "stranger"
  _  -> name

initial c = case c of
  'A' -> True
  _   -> False

----------------------------------------------------------------------
-- 7. Where clauses (on equations and on case alternatives)
----------------------------------------------------------------------

-- Simple where with multiple local bindings
hyp x y = root (sq x + sq y)
  where
    sq n = n * n
    root n = n

-- Where with local type signature
poly x = a * x * x + b * x + c
  where
    a, b, c : U64
    a = 2
    b = 3
    c = 5

-- Where on a case alternative (indented past the alt's pattern column)
greetN x =
  case x of
    0 -> formal
      where formal = "Greetings"
    _ -> "Hi"

-- Nested where (where inside a let-binding body)
nested x =
  let
    sq = mul x x
      where mul a b = a + b
  in sq

----------------------------------------------------------------------
-- 8. Higher-order, polymorphic, and complex type signatures
----------------------------------------------------------------------

-- Function-valued return type
flip' : (a -> b -> c) -> b -> a -> c
flip' f x y = f y x

-- Triply-applied type constructor
mapOption : (a -> b) -> Option a -> Option b
mapOption f m = case m of
  None   -> None
  Some x -> Some (f x)

----------------------------------------------------------------------
-- 9. Lexical quirks (documented warts)
----------------------------------------------------------------------

-- kebab-case identifiers (`-` allowed in middle/end of VarId)
like-this = 1
also-fine-yes = 2

-- Underscore-prefix names (Haskell `_unused` convention preserved)
useFirst _x y = y

-- Negative integer literal lexes as one token (WokInt)
negFive = -5

-- Subtraction requires spaces around `-` (`a-b` would be one VarId)
diff a b = a - b

-- Tight-scope if/then/else: parses as `(if c then 1 else 2) + 10`,
-- NOT Haskell's `if c then 1 else (2 + 10)`
ifPrec c = if c then 1 else 2 + 10

----------------------------------------------------------------------
-- 10. Operator definitions in four equivalent forms
--     NOTE: `(sym) x = ...` after another top-level decl needs an
--     explicit `;` on the preceding line - documented layout-filter
--     wart. These come last so the explicit `;`s are localized.
----------------------------------------------------------------------

-- Prefix VarId form (regular function - no special handling needed)
absurd x = x ;

-- Paren-prefix for symbolic operator (`;` above is required)
(<>) x y = x ;

-- Symbolic infix LHS
x </> y = y ;

-- Backtick infix LHS for alphabetic name
x `combine` y = x ;

-- Custom symbolic operator (any VarSym run is a valid operator name)
x ##== y = x
