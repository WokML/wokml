-- A small command machine that uses the whole mtl-style effect stack from
-- Control at once: Reader (config), State (a running total), Writer (a log
-- of snapshots), and Except (abort on a bad command). The commands are walked
-- RECURSIVELY, and the four handlers are stacked flatly with `with ... in`.
module Main
import Base
import Control

data Cmd = Inc U64 | Snapshot | Boom

-- Run one command. `Inc n` adds `n * step` to the total, where `step` is read
-- from the Reader config. `Snapshot` logs the current total. `Boom` aborts.
-- Each step reports 1 so the caller can count how many ran.
tick : Cmd -> U64 with Reader U64 + Writer [U64] + State U64 + Except String
tick cmd = case cmd of
  Inc n    -> let mult = Reader.ask in
              let cur  = State.get in
              let u    = State.set (cur + mult * n) in
              1
  Snapshot -> let cur = State.get in
              let u   = Writer.tell [cur] in
              1
  Boom     -> Except.throw "machine hit a Boom"

-- Walk the program recursively, summing the per-command counts.
-- (Named `walk`, not `run`: `run` is now the Control single-shot coroutine
-- driver, and a same-named top-level binding would shadow it ambiguously.)
walk : [Cmd] -> U64 with Reader U64 + Writer [U64] + State U64 + Except String
walk cmds = case cmds of
  []           -> 0
  cmd :: rest  -> tick cmd + walk rest

-- The four handlers stack top-to-bottom = outer-to-inner, so `state` is nearest
-- the computation and `except` is outermost (an abort discards state + log).
-- The result nests as Result ((count, finalState), log) String.
main : Result ((U64, U64), [U64]) String
main =
  handle except in
  handle reader 10 in
  handle writer in
  handle state 0 in
  walk [Inc 1, Snapshot, Inc 2, Snapshot]
