-- v2 FINAL surface. Redesign of examples/generators.wok. Shows: control clause,
-- return clause, cons as an EXPRESSION (`x :: k ()`, previously `[x] ++ k ()`),
-- default-label row. The arm resumes exactly once; the one-shot law holds.
module Main
import Base

effect Yield a
  yield : a -> ()

collect : Handler (Yield a) r [a]
collect = handler Yield
  yield x, k -> x :: k ()
  return u   -> []

count : U64 -> U64 -> () with Yield U64
count lo hi = case lo == hi of
  True  -> ()
  False ->
    Yield.yield lo
    count (lo + 1) hi

main : [U64]
main = handle collect in count 1 7
-- EXPECT OUTPUT: [1, 2, 3, 4, 5, 6]
