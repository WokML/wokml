-- v2 FINAL surface REJECT. The S1 shape under comma classification (D25).
-- The op's argument is itself a function. A head with NO comma is a PLAIN
-- arm, full stop, so the v1 control spelling below is not ambiguous -- it is
-- a plain arm binding one name too many, and E-ARITY blames the count
-- against the op type. (Note the one-binder spelling `call k -> k 41` is a
-- LEGAL plain arm -- the argument reading -- under any design with unmarked
-- plain arms; declared kinds make the two readings distinct SPELLINGS,
-- never a guess: the control spelling is `call f, k`.)
module Main
import Base

effect Call
  call : (U64 -> U64) -> U64

useCall : () -> U64 with Call
useCall () = Call.call (\n -> n + 1)

bad : Handler Call a a
bad = handler Call
  call f k -> k (f 41)
-- EXPECT: E-ARITY plain clause `call` binds 2 names but the op takes 1 argument
--         hint: control reading:  call f, k -> k (f 41)
--         hint: plain reading:    call f -> ...

main : U64
main = handle bad in useCall ()
