-- Rule 2: a comment with something before it on its line trails the item on
-- that line.
module M

f = 1  -- trails a declaration

g =
  let a = 1  -- trails a statement
  a  -- trails the last statement of a block

h = handler St
  var cur = 0  -- trails a var clause
  get   -> cur  -- trails a handler clause
  set x -> 2  -- trails the last clause

k x = case x of
  A -> 1  -- trails an alternative
  B -> 2  -- trails the last alternative
