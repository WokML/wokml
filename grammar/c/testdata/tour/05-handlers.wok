-- A tour of HANDLER and CAPABILITY forms: all five clause kinds, both
-- `handle` tiers, both `use` tiers, and every row-entry kind.
module Main.Tour.Handlers
import Base

type Msg = Ping U64 | Close

effect State s
  get : s
  set : s -> ()

effect Proto
  req : Msg -> U64

effect Emit a
  emit : a -> ()

effect Fail
  quit : String -> Never

-- The baton, two plain tail-resumptive arms and the value clause.
state : s -> Handler (State s) a (a, s)
state init = handler State
  var cur = init
  get      -> cur
  set x    -> cur := x
  return v -> (v, cur)

-- CONTROL arms, classified by the comma alone (D25). Left of it the binders
-- are ordinary patterns and must cover the argument type; right of it stands
-- one bare name, the continuation.
server : Handler Proto a a
server = handler Proto
  req (Ping n), k -> k n
  req Close, k    -> k 0

drain : Handler (Emit a) r [a]
drain = handler Emit
  emit x, k -> x :: k ()
  return u  -> []

-- An ABORT arm (D24): op arity only, no continuation to name, and the body IS
-- the answer -- the return clause does not run on this path.
bail : Handler Fail a (Result a String)
bail = handler Fail
  abort quit msg -> Err msg
  return v       -> Ok v

-- A hanging arm body: the first statement shares the arrow's line and the
-- rest stand in its column.
counted : Handler (State U64) a a
counted = handler State
  var cur = 0
  get   -> cur
  set x -> let next = x + 1
           cur := next
           ()

-- Row entries: a role obligation, a designation slot, and a row variable.
mixed : () -> U64 with (from : State U64) + Emit U64 + eff e
mixed () =
  let n = from.get
  Emit.emit n
  n

-- The statement tiers: a labelled `handle`, a bare `use` and a bridged call.
runMixed : U64
runMixed =
  handle from = state 1
  handle Emit = drain
  use from as State
  use from as State in mixed ()

-- The inline tiers, with and without a label.
inlineLabelled : U64
inlineLabelled = handle st = state 0 in st.get

inlineElided : U64
inlineElided = handle server in 0
