-- A tour of the LAYOUT shapes, written to exercise the filter's rules rather
-- than the grammar's forms. Every shape here is legal because of a specific
-- rule in wok_layout.h; the comment on each names it.
--
-- v2 has no `;`: block items are delimited by columns alone (D22).
module Main.Tour.Layout
import Base

-- L4/L5: a leading `|` continues the previous logical line, so a sum type may
-- be laid out one constructor per line. `=` leads a continuation too.
type Cmd
  = Inc U64
  | Snapshot
  | Boom

type Color = Red | Green | Blue

-- L4/L5: a leading `+` continues a capability row across lines. Nothing here
-- opens a block, so no INDENT is emitted at all.
tick : Cmd -> U64
       with Reader U64
          + Writer [U64]
          + State U64
tick cmd = 0

-- L4/L5 again, and the shape that motivated the rule: `in` lands on a column
-- matching no open level, and is legal precisely because a continuation is
-- exempt from dedent matching.
staged : U64
staged =
  let n =
        seed ()
        bump 1
    in n * 2

-- L4: `then`, `else` and `where` all lead continuations, so the whole
-- if-expression plus its where-block head is ONE logical line.
pick : Bool -> U64 -> U64
pick loud n =
  if loud
    then n + bump
    else negate n
  where
    bump = 10

-- L3: a block after `=`, then a nested block after `->`. Two INDENTs, both
-- owed by the grammar.
walk : [Cmd] -> U64
walk cmds = case cmds of
  []          -> 0
  cmd :: rest ->
    tick cmd
    walk rest

-- L2: layout is suspended inside brackets, so a bracketed expression lays out
-- freely -- including lines at or left of the enclosing block column.
table : [(U64, U64)]
table =
  [ (1, 2)
  , (3, 4)
  , (5, 6)
  ]

nested : U64
nested = sum (map (\x -> x + 1)
                  [1, 2, 3])

-- L3: the block-item separator is a column, and a deeper block may open from
-- a statement's right-hand side.
run : () -> U64
run () =
  let doubled =
        let m = seed ()
        m * 2
  _ = report doubled
  doubled
