-- EXPECT: E-ONCE-BINDER
-- D14: the last binder of a `once` clause IS the continuation, so it can only
-- be a plain lowercase name. A pattern there is unwritable, not reinterpreted.
module Main

effect Proto
  req : U64 -> U64

bad : Handler Proto a a
bad = handler Proto
  once req 0 -> 0

g : U64
g = 1
