module Main
import Base

effect State s
  get : s
  set : s -> ()

state : s -> Handler (State s) a (a, s)
state init = handler State
  var cur = init
  get -> cur
  set x -> cur := x
  return v -> (v, cur)

needsAmbient : () -> U64 with State U64
needsAmbient () = State.get

main : ((U64, U64), U64)
main =
  handle a = state 1
  handle b = state 2
  needsAmbient ()
