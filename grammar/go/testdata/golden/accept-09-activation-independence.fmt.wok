module Main
import Base

effect State s
  get : s
  set : s -> ()

state : s -> Handler (State s) a (a, s)
state init = handler State
  var cur = init
  get -> cur
  set x -> cur := x
  return v -> (v, cur)

main : (U64, U64)
main =
  let h = state 0
  let (x, s1) = handle h in State.set 1
  let (y, s2) = handle h in State.get
  (s1, s2)
