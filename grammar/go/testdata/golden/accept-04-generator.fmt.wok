module Main
import Base

effect Yield a
  yield : a -> ()

collect : Handler (Yield a) r [a]
collect = handler Yield
  once yield x k -> x :: k ()
  return u -> []

count : U64 -> U64 -> () with Yield U64
count lo hi = case lo == hi of
  True -> ()
  False ->
    Yield.yield lo
    count (lo + 1) hi

main : [U64]
main = handle collect in count 1 7
