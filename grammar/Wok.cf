-- wok grammar v2

entrypoints Module ;

-- Layout pragma: indentation-based blocks for let/where/case-of and top-level decls.
-- BNFC's layout filter inserts virtual {, ;, } tokens based on indentation, so the
-- grammar can be written with explicit braces while source code uses indentation.
--
--   layout toplevel ;          the file itself is a layout block of decls
--   layout "let", "where", "of"  after each of these, open an indented block
--   layout stop "in"           "in" closes the matching "let" block early
--
-- POST-REGEN NOTE: src-generated/GeneratedParser/Wok/Layout.hs needs a manual
-- patch after every `bnfc` regeneration. The auto-generated layout filter
-- skips `maybeInsertSeparator` on the combined `isLayoutOpen || isParenOpen`
-- branch, which breaks top-level decls starting with `(` (e.g.
-- `(+) : U64 -> U64 -> U64` as the second decl of a file). Split that one
-- branch into two and add the separator call only on the paren branch:
--   res pt st (t0 : ts)
--     | isLayoutOpen t0
--       = t0 : res (Just t0) (Explicit : st) ts
--     | isParenOpen t0
--       = maybeInsertSeparator pt t0 st $
--         t0 : res (Just t0) (Explicit : st) ts
-- (Note: the lambda binder must be `pt`, not `_`. Adding the separator on
-- the layout-open branch too would over-insert `;` before printed `let { ... }`
-- forms during round-trip parsing.) See git log for
-- `fix(parser): insert decl separator before paren-opening top-level decls`.
--
-- POST-REGEN NOTE: src-generated/GeneratedParser/Wok/Par.y needs a manual
-- patch after every `bnfc` regeneration. The auto-generated grammar emits a
-- right-recursive `ListRecordFieldPat` rule, which causes an LALR(1)
-- shift/reduce conflict: the parser absorbs the trailing comma before `..` in
-- the `PRecordOpen` production, making the open-record-pattern syntax
-- `Point { x = a, .. }` unparseable.
--
-- Fix: add a left-recursive `NEListRecordFieldPat` and route BOTH the plain
-- `PRecord` and the open `PRecordOpen` AtomPat rules through it (the
-- right-recursive auto-generated `ListRecordFieldPat` must NOT feed `PRecord`,
-- or it reintroduces the conflict). Build the list reversed in the Happy
-- semantic actions and `reverse` at each production root:
--
--   -- PATCH: left-recursive NEListRecordFieldPat to avoid shift/reduce conflict
--   --        with the trailing comma before `..` in PRecordOpen.
--   NEListRecordFieldPat
--     : RecordFieldPat
--         { [$1] }
--     | NEListRecordFieldPat ',' RecordFieldPat
--         { $3 : $1 }
--
--   -- Both PRecord and PRecordOpen use reverse(NEListRecordFieldPat):
--   AtomPat
--     : ConId '{' NEListRecordFieldPat '}'
--         { PRecord $1 (reverse $3) }
--     | ConId '{' NEListRecordFieldPat ',' PatRowTail '}'
--         { PRecordOpen $1 (reverse $3) $5 }
--
-- (The auto-generated `ListRecordFieldPat` rule may be left in place unused;
-- Happy only warns about the unused nonterminal.)
-- See commit e06ba60 `feat(tc): record patterns (Task 7)` for the applied patch.
--
-- POST-REGEN NOTE: src-generated/GeneratedParser/Wok/Par.y needs a third manual
-- patch after every `bnfc` regeneration. BNFC does NOT emit an empty-record
-- pattern rule for `ConId {}` (e.g. `Point {}`), and the left-recursive
-- `NEListRecordFieldPat` above is 1-or-more (it has no empty alternative), so
-- the empty record pattern is otherwise unparseable. Hand-add this AtomPat
-- alternative alongside the other record-pattern rules:
--
--   AtomPat
--     : ConId '{' '}' { GeneratedParser.Wok.Abs.PRecord $1 [] }
--
-- It produces the same `PRecord` node as the populated rule, with an empty
-- field list. Keep it as the first of the `ConId '{' ... '}'` alternatives.
--
-- POST-REGEN NOTE: slice 4d added the `DExternData` (`extern data ...`) and
-- `DExternType` (`extern type ...`) productions. They require NO manual patch
-- beyond the three above (`extern`/`data`/`type` are all already keywords, so
-- one-token lookahead after `extern` disambiguates cleanly). The patch list is
-- unchanged: keep applying exactly the three patches documented here.
--
-- POST-REGEN NOTE: slice B added the `TyParam` category (`TPPlain` bare VarId /
-- `TPRow` `(row e)`) for `data`/`extern data`/`extern type` type-constructor
-- parameters, plus the `TRowArg` Type2 (`(row e)` as a type argument). No new
-- manual patch is required (`row` is already a keyword; the `(` ... `)` framing
-- disambiguates cleanly). The patch list stays at exactly the three above.
--
-- POST-REGEN NOTE: FFI Slice 4 (Task 0) added the `TOwned` Type2 (`owned Type2`,
-- a transfer-full argument modifier on a foreign-member parameter type). It
-- requires NO manual patch beyond the three above: `owned` is already a keyword
-- (consumed by `FMOwned` before the `:` in a ForeignMember), and `TOwned` is
-- only reachable AFTER the `:`, inside a `Type` -- a distinct LALR(1) context,
-- so the two `owned` productions never compete for the same lookahead. The
-- patch list stays at exactly the three above.
layout toplevel ;
layout "let", "where", "of" ;
layout stop "in" ;

Module.   Module ::= [Decl] ;

DEqn.     Decl ::= FunLHS "=" Exp MaybeWhere ;
DSig.     Decl ::= SigName [SigNameComma] ":" Type ;   -- multi-name sig; name may be VarId or (VarSym)
DExtern.  Decl ::= "extern" SigName [SigNameComma] ":" Type ; -- explicit compiler-hole primitive; same shape as a bodyless DSig but intentional (no lint)
DData.    Decl ::= "data" ConId [TyParam] "=" [ConDef] ;
DExternData. Decl ::= "extern" "data" ConId [TyParam] "=" [ConDef] ; -- marked carrier ADT (Embedded-only; gate in Infer)
DExternType. Decl ::= "extern" "type" ConId [TyParam] ;              -- marked opaque carrier (Embedded-only)
DEffect.  Decl ::= "effect" ConId [VarId] "=" "{" [RecordFieldType] "}" ;
DFixity.  Decl ::= "fixity" FixName FixAssoc [FixRel] ;

-- Type classes (Eq slice). These declarations are fully processed: the
-- typechecker registers each class/instance, checks coherence/termination/
-- completeness, and elaboration desugars instances into dictionaries with
-- dictionary-passing. Reordering passes them through (no top-level exprs there).
-- The `where "{" ... "}"` braces are layout-virtual: `where` is already a layout
-- keyword (see `layout "let", "where", "of" ;`).
DClass.    Decl ::= "class" ConId [VarId] "where" "{" [ClassEntry] "}" ;
DInstance. Decl ::= "instance" InstHead "where" "{" [InstEntry] "}" ;

-- Foreign module: a namespaced group of FFI bindings to a C library (Slice 2).
-- `where "{" ... "}"` is layout-virtual (where is a layout keyword, see :87 and
-- the DClass note at :105-106). The library string selects the host binding set;
-- `free String` (optional) names the deallocator for `owned` (transfer-full)
-- members. A member's C symbol defaults to its name; an optional leading string
-- overrides it. `owned` on a member = transfer full (adopt + free at rc-zero);
-- its absence = copy (transfer none).
DForeign.   Decl ::= "foreign" "module" ConId String ForeignFree "where" "{" [ForeignMember] "}" ;
FFNone.     ForeignFree ::= ;
FFSym.      ForeignFree ::= "free" String ;
FMPlain.    ForeignMember ::= VarId ForeignSym ":" Type ;
FMOwned.    ForeignMember ::= "owned" VarId ForeignSym ":" Type ;
FSNone.     ForeignSym ::= ;
FSName.     ForeignSym ::= String ;
separator   ForeignMember ";" ;

IHPlain.   InstHead ::= ConId [Type2] ;
IHCtx.     InstHead ::= "(" [Constraint] ")" "=>" ConId [Type2] ;

MNBare.    MethodName ::= VarId ;
MNParen.   MethodName ::= "(" VarSym ")" ;

CESig.     ClassEntry ::= MethodName ":" Type ;
CEDefault. ClassEntry ::= FunLHS "=" Exp ;
separator  ClassEntry ";" ;

IEImpl.    InstEntry ::= FunLHS "=" Exp ;
separator  InstEntry ";" ;

Constraint. Constraint ::= ConId [Type2] ;
separator   Constraint "," ;

separator Decl ";" ;

-- Hierarchical dotted module paths (e.g. Data.List)
MPName.   ModPath ::= ConId ;
MPDot.    ModPath ::= ModPath "." ConId ;

-- Module-level declarations.
-- DModule is conventionally the first decl; a later semantic pass enforces
-- "present, first, unique". DLocal recursively wraps any Decl; the semantic
-- pass restricts it to value/type/data/fixity decls.
DModule.  Decl ::= "module" ModPath ;
DImport.  Decl ::= "import" ModPath ;
DUse.     Decl ::= "use" ModPath ;
DLocal.   Decl ::= "local" Decl ;

-- Reserved for future language features. ReservedKw exists only so BNFC adds
-- these words to the lexer's reserved set, keeping them out of VarId. When a
-- feature ships, move its word out of here into that feature's real production.
rules     ReservedKw ::= "contract" | "type" | "deriving" | "forall"
                       | "do" | "record" | "row" | "fun" | "ctl" ;
DReserved. Decl ::= ReservedKw ;

-- Helper: comma-separated additional names for multi-name sigs (`f, (+), h : T`).
-- A SigName is either a bare VarId or a parenthesised VarSym, mirroring the
-- FunName design on the LHS-of-equation side (FNBare / FNParen). BNFC allows
-- only ONE `separator <Cat> <sep>` declaration per category, and the comma
-- separator is dedicated to this multi-name sig list.
SNBare.   SigName ::= VarId ;
SNParen.  SigName ::= "(" VarSym ")" ;

SNCons.   SigNameComma ::= "," SigName ;
separator SigNameComma "" ;

-- For `data T a b c = ...`, type params are bare VarIds (whitespace-separated list)
separator VarId "" ;

-- Type-constructor parameters: a bare VarId (kind *) or `(row VarId)` (kind Row/KEffect, slice B).
TPPlain.  TyParam ::= VarId ;
TPRow.    TyParam ::= "(" "row" VarId ")" ;
separator TyParam "" ;

-- Function LHS — four equivalent forms for defining operators:
--   add x y    = ...   (LHSPre, FNBare VarId)
--   (+) x y    = ...   (LHSPre, FNParen)
--   x + y      = ...   (LHSInfSym — symbolic infix)
--   x `add` y  = ...   (LHSInfBT — backtick-wrapped alphabetic infix)
--
-- LALR(1) disambiguation:
--   second token after the first FunName/AtomPat decides:
--     - VarId, AtomPat-starter (paren, bracket, literal, _) -> LHSPre (more args)
--     - VarSym -> LHSInfSym (commit to infix)
--     - backtick -> LHSInfBT
LHSPre.    FunLHS ::= FunName [AtomPat] ;
LHSInfSym. FunLHS ::= AtomPat VarSym AtomPat ;
LHSInfBT.  FunLHS ::= AtomPat "`" VarId "`" AtomPat ;

FNBare.    FunName ::= VarId ;
FNBareSym. FunName ::= VarSym ;
FNParen.   FunName ::= "(" VarSym ")" ;

-- Patterns (full version: variable, wildcard, literals, constructor app, cons, tuple, list)
--
-- Pat is the top-level pattern with constructor application and right-assoc cons.
-- AtomPat is the non-applied atom shape used as constructor args, ELam binders,
-- LHSPre args, and inside parens.
--
-- Design note: PApp requires at least one AtomPat argument (ConId AtomPat [AtomPat]).
-- Nullary constructors and bare variables both arrive as PAtom; APCon covers nullary
-- constructors, APVar covers variables. The ConId/VarId lexical split means the
-- semantic pass no longer needs first-character inspection. The pre-split grammar
-- used `VarId [AtomPat]` for PApp; that caused a reduce/reduce conflict (zero-arg
-- list clashed with APVar. AtomPat ::= VarId). The lexer-level split eliminates it.
PApp.     Pat ::= ModPath AtomPat [AtomPat] ; -- constructor applied to 1+ args
PCons.    Pat ::= AtomPat "::" Pat ;        -- right-associative cons
-- PAtom is an explicit wrapper (NOT a transparent `_.` coercion). BNFC's `_.` only
-- works between same-base-category precedence levels (e.g., Exp/Exp1/Exp2), not
-- between distinct categories like Pat and AtomPat. Downstream semantic / resolver
-- code must `case` on PAtom to unwrap to AtomPat.
PAtom.    Pat ::= AtomPat ;                -- atom (var, wildcard, lit, paren, list, tuple) as Pat

APVar.    AtomPat ::= VarId ;
APCon.    AtomPat ::= ModPath ;
APWild.   AtomPat ::= "_" ;
APLitI.   AtomPat ::= WokInt ;
APLitS.   AtomPat ::= String ;
APLitC.   AtomPat ::= Char ;
APTuple.  AtomPat ::= "(" Pat "," [Pat] ")" ;   -- 2-or-more; single-element is APParen
APList.   AtomPat ::= "[" [Pat] "]" ;
APParen.  AtomPat ::= "(" Pat ")" ;
PUnit.    AtomPat ::= "(" ")" ;          -- unit pattern; whitespace permitted: ( ), (   )
APAs.     AtomPat ::= AtomPat "as" VarId ;   -- <atom pattern> as name; left-recursive, BNFC-friendly

-- Record patterns.
-- PRecord     : Point { x = a, y = b }       (strict, matches only exact Point)
-- PRecordOpen : Point { x = a, .. }          (open, matches Point + any extension)
-- PRecordWild : Point { .. } or Point { ..rest }  (PRTNamed parses; elaborator rejects)
PRecord.       AtomPat ::= ConId "{" [RecordFieldPat] "}" ;
PRecordOpen.   AtomPat ::= ConId "{" [RecordFieldPat] "," PatRowTail "}" ;
PRecordWild.   AtomPat ::= ConId "{" PatRowTail "}" ;

RFPat.         RecordFieldPat ::= VarId "=" Pat ;
separator      RecordFieldPat "," ;

PRTNamed.      PatRowTail ::= ".." VarId ;
PRTAnon.       PatRowTail ::= ".." ;

separator AtomPat "" ;   -- covers both LHSPre args and ELam binders
separator Pat "," ;

-- Types (Task 8: full type expressions)
--
-- Precedence levels:
--   Type  = TFun: right-assoc function arrow `A -> B -> C` = `A -> (B -> C)`
--   Type1 = AppType: left-assoc juxtaposition application `Maybe a b` = `(Maybe a) b`
--   Type2 = AtomType: type var/ctor, list type, tuple type, paren
--
-- Mapping to spec's pseudo-grammar:
--   spec's `Type`    = our `Type`
--   spec's `AppType` = our `Type1`
--   spec's `AtomType`= our `Type2`

-- `with` binds looser than `->`. The arrow keeps its ORIGINAL precedence shape
-- (`TFun. Type ::= Type1 "->" Type`, right-associative, recursing on `Type`) so
-- BNFC's pretty-printer parenthesizes arrow result types exactly as before --
-- renumbering the arrow makes the printer wrap results in spurious parens
-- (`Int -> (Int)`), breaking round-trips.
--
-- `with` attaches at the same `Type` level: TWith puts a trailing `with E` after
-- a `Type1 "->" Type` arrow. Because both TWith and TFun start with the same
-- `Type1 "->" Type` prefix, the parser defers the `with`-vs-end decision until
-- after the arrow body, so a trailing `with E` binds to the whole arrow chain.
-- Qualified type (Eq slice, Task 0): `(C a) => T` is the loosest type form,
-- recursing on the whole `Type` to its right. Parse-only for now; the
-- typechecker ignores the constraint context.
--
-- DESIGN NOTE (LALR(1) constraint): the context LHS is parsed as an ordinary
-- `Type1`, NOT as a dedicated `"(" [Constraint] ")"`. A separate
-- comma-separated `[Constraint]` nonterminal here is unparseable: inside `(`,
-- a leading `ConId` (e.g. `Int` in the tuple type `(Int, String)`) cannot be
-- resolved between `Constraint -> ConId ...` and `ModPath -> ConId` until the
-- post-`)` token (`=>` vs end), which LALR(1) cannot defer. That ambiguity
-- produces reduce/reduce conflicts and silently breaks tuple/paren types.
-- Parsing the LHS as a `Type1` shares the inner reduction with TParen/TTuple,
-- so the only decision left is the post-`)` operator token (`=>` vs `->`/end),
-- a clean shift/reduce. The surface form `(Eq a)` arrives as a TParen of a
-- TApp, and `(Eq a, Ord b)` as a TTuple; a later semantic pass reinterprets
-- the LHS `Type` as the constraint context `[Constraint]`.
TQual.    Type  ::= Type1 "=>" Type ;
TWith.    Type  ::= Type1 "->" Type "with" EffectRow ;
TFun.     Type  ::= Type1 "->" Type ;       -- right-assoc function arrow
_.        Type  ::= Type1 ;

-- Effect rows (right operand of `with`).
--
-- The `+` separator is captured via `VarSym`, NOT a literal "+", for the same
-- reason TExtend does it: a literal "+" would promote `+` into a reserved
-- symbol and pull it out of VarSym, breaking `fixity + left`, the type-level
-- `a + b` extension, and every `+` operator in source. The elaborator restricts
-- this VarSym to the literal "+".
ERAtom.     EffectAtom ::= ConId [Type2] ;
EROne.      EffectRow ::= EffectAtom ;
ERPlus.     EffectRow ::= EffectAtom VarSym EffectRow ;
ERVarOnly.  EffectRow ::= "eff" VarId ;
ERWildOnly. EffectRow ::= ".." ;

TApp.     Type1 ::= Type1 Type2 ;          -- left-assoc type application
_.        Type1 ::= Type2 ;

TVar.     Type2 ::= VarId ;                -- type variable
TCon.     Type2 ::= ModPath ;              -- type constructor (qualified or bare)
TList.    Type2 ::= "[" Type "]" ;
TTuple.   Type2 ::= "(" Type "," [Type] ")" ;
TParen.   Type2 ::= "(" Type ")" ;
TUnit.    Type2 ::= "(" ")" ;            -- unit type; whitespace permitted
TRowArg.  Type2 ::= "(" "row" VarId ")" ;   -- a row variable as a type argument (slice B)
TOwned.   Type2 ::= "owned" Type2 ;   -- FFI Slice 4: transfer-full argument modifier

-- Type-level extension `Point + ext` (left-assoc; tighter than `->`).
-- The `+` token is captured via `VarSym`; the elaborator restricts to literal "+"
-- so we don't have to promote `+` out of `VarSym` globally and break expression
-- syntax.
TExtend.       Type1 ::= Type1 VarSym RowContrib ;

-- RowContrib is the right operand of type-level `+`.
-- RCAnon is a concrete record literal (anonymous row contribution).
-- RCVar is a row variable, marked by the `row` keyword (distinguishes row
-- vars from ordinary type vars at the surface level).
-- Anonymous record types CANNOT appear elsewhere in Type expressions -- they
-- live only here.
RCAnon.        RowContrib ::= "{" [RecordFieldType] "}" ;
RCVar.         RowContrib ::= "row" VarId ;
RCWild.        RowContrib ::= ".." ;

separator Type "," ;

-- Constructor definition body for `data`. Three forms:
--   ConDef         positional:        Cons a (List a)
--   ConDefRec      record, named:     Point { x : U64, y : U64 }
--   ConDefRecElide record, name elided (single-con record decls only; elaborator-enforced)
ConDef.         ConDef ::= ConId [Type2] ;
ConDefRec.      ConDef ::= ConId "{" [RecordFieldType] "}" ;
ConDefRecElide. ConDef ::= "{" [RecordFieldType] "}" ;

RFType.        RecordFieldType ::= VarId ":" Type ;
separator      RecordFieldType "," ;

separator ConDef "|" ;
separator Type2 "" ;

-- Fixity decls
FNSym.    FixName ::= VarSym ;
FNAlpha.  FixName ::= VarId ;

FALeft.   FixAssoc ::= "left" ;
FARight.  FixAssoc ::= "right" ;

FRTight.  FixRel ::= "tighter" "than" FixName ;
FRLoose.  FixRel ::= "looser" "than" FixName ;

separator FixRel "" ;

-- Expressions (Task 6: atoms + juxtaposition application + infix operator chains
--              + lambda, let, case, if-then-else)
--
-- Precedence levels:
--   Exp   = EExpr: head Exp1 + flat list of InfixTail entries (deferred precedence)
--   Exp1  = AppExp (left-assoc juxtaposition)
--   Exp2  = AtomExp (parenthesised, list, tuple, literals, var, lambda, let, case, if)

EExpr.    Exp  ::= Exp1 [InfixTail] ;

ITail.    InfixTail ::= InfixOp Exp1 ;
separator InfixTail "" ;

IOSym.    InfixOp ::= VarSym ;
IOBT.     InfixOp ::= "`" VarId "`" ;

EApp.     Exp1 ::= Exp1 Exp2 ;    -- left-assoc juxtaposition application
_.        Exp1 ::= Exp2 ;

EVar.     Exp2 ::= VarId ;
ECon.     Exp2 ::= ConId ;
EProj.    Exp2 ::= Exp2 "." VarId ;
EProjC.   Exp2 ::= Exp2 "." ConId ;
-- Value-level record construction.
-- ERecord    : Point { x = 1, y = 2 }
-- ERecordExt : Point { ..p } or Point { ..p, x = 99 } (trailing fields optional, G3 fix)
ERecord.       Exp2 ::= ConId "{" [RecordFieldExpr] "}" ;
ERecordExt.    Exp2 ::= ConId "{" ".." Exp MaybeTrailing "}" ;

-- Optional trailing field list after the spread in ERecordExt.
-- MaybeTrailing allows `Point { ..p }` or `Point { ..p, x = 99 }`.
TFNone.        MaybeTrailing ::= ;
TFSome.        MaybeTrailing ::= "," [RecordFieldExpr] ;

RFExpr.        RecordFieldExpr ::= VarId "=" Exp ;
separator      RecordFieldExpr "," ;

ELitI.    Exp2 ::= WokInt ;
ELitS.    Exp2 ::= String ;
ELitC.    Exp2 ::= Char ;
EParen.   Exp2 ::= "(" Exp ")" ;
EParenOp. Exp2 ::= "(" VarSym ")" ;    -- (+), (>>=), etc.
EUnit.    Exp2 ::= "(" ")" ;           -- unit value; whitespace permitted
EList.    Exp2 ::= "[" [Exp] "]" ;
ETuple.   Exp2 ::= "(" Exp "," [Exp] ")" ;
-- Lambda binders are AtomPat (not full Pat) per Haskell convention: a binder
-- like `\Just x -> ...` would be ambiguous (one constructor pattern vs two
-- variable binders), so constructor / cons patterns must be paren-wrapped:
-- `\(Just x) -> ...`. NOTE: the spec text says `[Pat]` here; the grammar
-- intentionally uses `[AtomPat]` for the disambiguation reason above.
ELam.     Exp2 ::= "\\" [AtomPat] "->" Exp ;
ELet.     Exp2 ::= "let" "{" [LocalDecl] "}" "in" Exp ;
-- Empty `case x of { }` is syntactically allowed (BNFC list is 0-or-more);
-- semantic pass should reject non-exhaustive empty alternatives.
ECase.    Exp2 ::= "case" Exp "of" "{" [Alt] "}" ;
EIf.      Exp2 ::= "if" Exp "then" Exp "else" Exp ;
-- Effect handlers: `with { arms } computation` (flat prefix). The handler block
-- uses EXPLICIT braces (`with` cannot be a layout keyword without breaking the
-- type-level `with` in `T -> R with E`). The trailing Exp is the handled
-- computation, consumed like a lambda body (EWith is Exp2, body is full Exp).
-- A value arm (HVArm) is the return clause; the `return` keyword is gone. The
-- optional continuation binder is the (arity+1)-th AtomPat on an operation arm,
-- split from the op's arguments by the typechecker (Task 2), so HArm is unchanged.
-- Headerless handler (slice 1): every arm is dot-qualified.
EWith.    Exp2 ::= "with" "{" [HandlerArm] "}" Exp ;
-- Headed handler (slice 2): a non-empty ConId run names the handled effects so
-- arms may drop the qualifier. The first ConId is mandatory (so an empty header
-- cannot collide with EWith); the rest is a whitespace-separated [ConId] tail.
EWithH.   Exp2 ::= "with" ConId [ConId] "{" [HandlerArm] "}" Exp ;
-- Runner sugar: `with <runner> <args> in <body>` ≡ `<runner> <args> (\_ -> <body>)`.
-- VarId-headed (lowercase runner fn) so it never collides with EWithH (ConId-headed)
-- or EWith (`{`-headed). slice 4a.
EWithRun. Exp2 ::= "with" VarId [WithArg] "in" Exp ;
-- Named-instance introduction (named effect instances feature, Task 1). Both
-- bind a fresh lowercase `VarId` instance name with `=`, then `in` the body.
-- The `=` immediately after `with VarId` disambiguates from EWithRun (no `=`)
-- and EWithH (ConId-headed). The binder is a bare VarId: deliberately
-- SIGIL-FREE (no `&`). EWithNamed names a runner application; EWithNamedH
-- names a primitive handler block.
EWithNamed.  Exp2 ::= "with" VarId "=" VarId [WithArg] "in" Exp ;
EWithNamedH. Exp2 ::= "with" VarId "=" ConId "{" [HandlerArm] "}" "in" Exp ;
WRArg.    WithArg ::= Exp2 ;
separator WithArg "" ;
-- Qualified operation arm (unchanged).
HArm.     HandlerArm ::= ConId "." VarId [AtomPat] "->" Exp ;
-- Unqualified arm: covers BOTH the value arm (`v -> e`, zero AtomPats) and an
-- unqualified operation arm (`get -> e`, `set s -> e`). The typechecker classifies
-- each by resolving the head name against the header. Replaces HVArm.
HUArm.    HandlerArm ::= VarId [AtomPat] "->" Exp ;
-- Handler-local parameter: a `name = init` seed entry inside the handler block.
-- `=` distinguishes it from the `->` of op/value arms (HUArm/HArm). slice 4a.
HParam.   HandlerArm ::= VarId "=" Exp ;
HParamV.  HandlerArm ::= "var" VarId "=" Exp ;
separator HandlerArm ";" ;
separator ConId "" ;

separator Exp "," ;   -- shared by EList and ETuple bodies

-- Local decls (for `let` blocks; same shape allowed in `where` blocks in Task 9)
LDEqn.    LocalDecl ::= FunLHS "=" Exp MaybeWhere ;
LDSig.    LocalDecl ::= SigName [SigNameComma] ":" Type ;
-- Tuple/wildcard destructuring bind: `let (a, b) = e`. The LHS is the inlined
-- 2-or-more tuple shape (NOT a bare AtomPat), so a bare `x` never reduces toward
-- it -- `x = e` stays an LDEqn value bind. The leading `(` plus a comma make this
-- unambiguous: `(a, b)` is not a FunName (LDEqn/LHSPre) and `=` is not a VarSym
-- (LHSInfSym), so `(a, b) = e` routes here without a reduce/reduce conflict on the
-- shared bare-VarId state. Components are full Pat (covers `_` wildcards and
-- nested tuples); refutable components are rejected in the type checker.
LDPat.    LocalDecl ::= "(" Pat "," [Pat] ")" "=" Exp ;
separator LocalDecl ";" ;

-- Optional where-block attached to DEqn / LDEqn / AltC
-- LocalDecl in where is the restricted subset (LDEqn + LDSig only; no nested data/fixity).
NoWhere.  MaybeWhere ::= ;
WithWh.   MaybeWhere ::= "where" "{" [LocalDecl] "}" ;

-- Case alternatives
AltC.     Alt ::= Pat "->" Exp MaybeWhere ;
separator Alt ";" ;

-- Token definitions (carried forward from Task 2)

-- Negative integer literal: `-` immediately followed by digits lexes as one WokInt token.
-- The lexer's longest-match rule ensures `-5` wins over splitting into VarSym "-" + WokInt 5.
-- Trade-off (documented wart): `1-2` lexes as [1, -2] not [1, -, 2]; subtraction needs spaces.
-- NOTE: We use `WokInt` (not `Integer`) because BNFC does not allow overriding its built-in
-- `Integer` token; attempting to redefine `Integer` results in a duplicate token in Par.y.
position token WokInt ('-')? digit+ ;

position token ConId
  upper (letter | digit | '_' | '\'' | '-')*
  ;

position token VarId
  (lower | '_') (letter | digit | '_' | '\'' | '-')*
  ;

position token VarSym
  ('!' | '#' | '$' | '%' | '&' | '*' | '+' | '/' |
   '<' | '=' | '>' | '?' | '@' | '\\' | '^' | '|' | '-' | '~')+
  ;

comment "--" ;
comment "{-" "-}" ;
