cabal-version:      3.0
name:               wok
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             zypeh
maintainer:         zhengyan@posteo.net
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
data-files:         prelude/Base.wok
                    prelude/Control.wok
                    prelude/Array.wok
                    prelude/String.wok
                    prelude/Bytes.wok
                    prelude/Borrow.wok

-- Enable AddressSanitizer for the C runtime and the wok executable.
-- WOK_RC_MALLOC forces the slab pool to fall back to plain malloc, giving
-- ASan real redzones around every allocation so overreads are visible.
-- Default: False (normal build is byte-identical without this flag).
flag asan
  description: Build with AddressSanitizer (ASan). Requires clang + ASan runtime.
  default:     False
  manual:      True

-- Negative-control flag: drop the strndup scan clamp in the RC interpreter so
-- a too-large n overreads the borrowed buffer. Combined with -fasan this MUST
-- abort under ASan, proving the clamp gate has teeth.
-- Default: False (never enabled in a normal build).
flag ffi-noclamp-negctrl
  description: Drop the strndup scan clamp (ASan negative control only). NEVER use in production.
  default:     False
  manual:      True

-- Negative-control flag (FFI Slice 3 Task 6 death-test matrix): disable the
-- foreign-borrow carrier ESCAPE rejection (CarrierEscape) in the type checker so
-- a Borrow that escapes its lending activation type-checks and can be RUN.
-- Combined with -fasan this turns each escape route into a GENUINE ASan
-- use-after-free (the activation-scoped close frees the malloc'd buffer the
-- escapee then reads), proving the carrier rule is load-bearing.
-- Default: False (never enabled in a normal build).
flag ffi-borrow-noescape-negctrl
  description: Disable the Borrow carrier escape check (ASan death-test negative control only). NEVER use in production.
  default:     False
  manual:      True

-- Negative-control flag (FFI Slice 4 Task 6 death-test matrix): defeat the
-- owned-INTO-C router's copy-when-shared guard in the RC interpreter's
-- ("wok","consume") dispatch (Wok.Interp.RC.Machine) so a SHARED Bytes (rc>1)
-- is hard-freed via a raw libc 'free' instead of copied, modeling a C consumer
-- that took the raw shared buffer and freed it directly, bypassing wok's
-- refcount. Combined with -fasan this turns a later touch of the buffer (a
-- sibling's normal drop, or a sibling's Libc.memchr read) into a GENUINE ASan
-- use-after-free / double-free, proving the copy-when-shared guard has teeth.
-- Default: False (never enabled in a normal build).
flag ffi-owned-noguard-negctrl
  description: Defeat the owned-INTO-C copy-when-shared guard (ASan death-test negative control only). NEVER use in production.
  default:     False
  manual:      True

-- Negative-control flag (FFI Slice 4 Task 6 death-test matrix, DOUBLE-FREE class):
-- like ffi-owned-noguard-negctrl, but the mutated shared branch frees the cell
-- pointer TWICE back-to-back (free; free). ASan intercepts the SECOND free on the
-- already-freed pointer and reports a genuine `attempting double-free` (a distinct
-- class from the use-after-free the single-hard-free control produces via a later
-- read), faithfully modeling the move-out double-free hazard (the buffer freed by
-- BOTH C and wok). Default: False (never enabled in a normal build).
flag ffi-owned-doublefree-negctrl
  description: Free the owned-INTO-C buffer twice (ASan double-free death-test negative control only). NEVER use in production.
  default:     False
  manual:      True

-- Plain -Wall, used by the generated parser sublibrary (BNFC/alex/happy
-- output carries unavoidable warnings, so it must NOT be -Werror).
common warnings
    ghc-options: -Wall

-- Strict warnings for hand-written code: -Wall plus exhaustiveness checks,
-- all promoted to errors. -Wincomplete-patterns is deliberately added because
-- it is NOT part of -Wall; its absence let a non-exhaustive `reorderDecl`
-- (missing the DEffect case) compile cleanly and crash at runtime.
common strict
    default-language: GHC2024
    default-extensions:
        Strict
        StrictData
        LambdaCase
        OverloadedStrings
    ghc-options:
        -Wall
        -Werror
        -Wincomplete-patterns
        -Wincomplete-uni-patterns
        -funbox-strict-fields

common executable-flags
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N -A4m -n2m"

-- Generated BNFC + alex + happy parser modules. Kept in a separate
-- internal sublibrary because alex's lexer relies on laziness in its
-- state machine; library-wide Strict/StrictData would break it.
library wok-generated
    import:           warnings
    visibility:       public
    exposed-modules:
        GeneratedParser.Wok.Abs
        GeneratedParser.Wok.Lex
        GeneratedParser.Wok.Par
        GeneratedParser.Wok.Print
        GeneratedParser.Wok.Layout
        GeneratedParser.Wok.ErrM
    build-depends:
        base         ^>=4.20,
        array        ^>=0.5,
        text
    hs-source-dirs:   src-generated
    default-language: GHC2024
    -- NOTE: cabal auto-invokes alex (.x) and happy (.y) but NOT bnfc (.cf).
    -- BNFC is listed so `cabal install --only-dependencies` pulls it in; the
    -- grammar must still be regenerated manually after editing grammar/Wok.cf:
    --   bnfc --haskell -d --text-token -o src-generated grammar/Wok.cf
    build-tool-depends:
        BNFC:bnfc,
        alex:alex,
        happy:happy

-- Hand-written wok modules: strict by default. The TypeChecking
-- inferrer is fundamentally strict (in-place unification via ST,
-- monotonic counters, complete tree walks), so Strict/StrictData
-- is a uniform improvement.
library
    import:           strict
    exposed-modules:
        Wok.Loader
        Wok.Parsing
        Wok.Pipeline
        Wok.Prelude
        Wok.RecordLayout
        Wok.Reordering
        Wok.Sexp.Read
        Wok.Sexp.Surface
        Wok.SourceOrigin
        Wok.TypeChecking
        Wok.TypeChecking.Types
        Wok.TypeChecking.Env
        Wok.TypeChecking.Error
        Wok.TypeChecking.Monad
        Wok.TypeChecking.Unify
        Wok.TypeChecking.Infer
        Wok.TypeChecking.Class
        Wok.TypeChecking.Builtins
        Wok.TypeChecking.Solve
        Wok.TypeChecking.Typed
        Wok.TypeChecking.Carrier
        Wok.FFI.Blessed
        Wok.IR.Name
        Wok.IR.PrimNames
        Wok.IR.Anf
        Wok.IR.Escape
        Wok.IR.Region
        Wok.IR.Elaborate
        Wok.IR.Match
        Wok.IR.Multiplicity
        Wok.IR.Perceus
        Wok.IR.ReusePairing
        Wok.IR.Reachable
        Wok.Interp
        Wok.Interp.Value
        Wok.Interp.Prim
        Wok.Interp.Utf8
        Wok.Interp.Sched
        Wok.Interp.ForeignModels
        Wok.Interp.Machine
        Wok.Interp.RC.Heap
        Wok.Interp.RC.Value
        Wok.Interp.RC.Prim
        Wok.Interp.RC.Machine
        Wok.Runtime.StringZilla
    c-sources:        runtime/wok_rc.c
                      runtime/wok_str_ops.c
                      runtime/wok_utf8.c
    include-dirs:     runtime
                      runtime/vendor
    cc-options:       -std=c17 -O3 -fstrict-aliasing -Wstrict-aliasing=2 -fwrapv
                      -Werror -Wall -Wextra -Wpedantic -Wconversion
                      -Wdouble-promotion -Wstrict-prototypes -Wformat-security
    if flag(asan)
      cc-options:     -fsanitize=address -fno-omit-frame-pointer -DWOK_RC_MALLOC
      -- Also surface WOK_RC_MALLOC to GHC's CPP (cc-options above only reaches
      -- the C compiler): Wok.Interp.RC.Machine's negctrl flags '#error' out at
      -- Haskell compile time if a negctrl flag is enabled WITHOUT this backend
      -- (see the guard near its other CPP checks), since the negctrl mutations
      -- call libc 'free()' directly on a cell pointer -- well-defined ONLY under
      -- the real-malloc WOK_RC_MALLOC backend, UB against the slab arena.
      cpp-options:    -DWOK_RC_MALLOC
    if flag(ffi-noclamp-negctrl)
      cpp-options:    -DWOK_FFI_NOCLAMP_NEGCTRL
    if flag(ffi-borrow-noescape-negctrl)
      cpp-options:    -DWOK_FFI_BORROW_NOESCAPE_NEGCTRL
    if flag(ffi-owned-noguard-negctrl)
      cpp-options:    -DWOK_FFI_OWNED_NOGUARD_NEGCTRL
    if flag(ffi-owned-doublefree-negctrl)
      cpp-options:    -DWOK_FFI_OWNED_DOUBLEFREE_NEGCTRL
    autogen-modules:
        Paths_wok
    other-modules:
        Paths_wok
    build-depends:
        base         ^>=4.20,
        array        ^>=0.5,
        bytestring,
        containers,
        mtl,
        text,
        transformers,
        wok:wok-generated
    hs-source-dirs:   src

executable wok
    import:           strict, executable-flags
    main-is:          Main.hs
    build-depends:
        base ^>=4.20,
        wok,
        containers,
        text
    hs-source-dirs:   app
    if flag(asan)
      ghc-options:    -optl-fsanitize=address

test-suite wok-tests
    import:           strict
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base ^>=4.20,
        wok,
        wok:wok-generated,
        tasty,
        tasty-golden,
        tasty-hunit,
        tasty-quickcheck,
        QuickCheck,
        bytestring,
        containers,
        filepath,
        directory,
        process,
        mtl,
        transformers,
        text
    hs-source-dirs:   test
