cabal-version:      3.0
name:               wok
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             zypeh
maintainer:         zhengyan@posteo.net
category:           Language
build-type:         Simple
extra-doc-files:    CHANGELOG.md
data-files:         prelude/Std/Base.wok
                    prelude/Std/Control.wok

-- Plain -Wall, used by the generated parser sublibrary (BNFC/alex/happy
-- output carries unavoidable warnings, so it must NOT be -Werror).
common warnings
    ghc-options: -Wall

-- Strict warnings for hand-written code: -Wall plus exhaustiveness checks,
-- all promoted to errors. -Wincomplete-patterns is deliberately added because
-- it is NOT part of -Wall; its absence let a non-exhaustive `reorderDecl`
-- (missing the DEffect case) compile cleanly and crash at runtime.
common strict
    default-language: GHC2024
    default-extensions:
        Strict
        StrictData
        LambdaCase
        OverloadedStrings
    ghc-options:
        -Wall
        -Werror
        -Wincomplete-patterns
        -Wincomplete-uni-patterns
        -funbox-strict-fields

common executable-flags
  ghc-options:         -threaded -rtsopts "-with-rtsopts=-N -A4m -n2m"

-- Generated BNFC + alex + happy parser modules. Kept in a separate
-- internal sublibrary because alex's lexer relies on laziness in its
-- state machine; library-wide Strict/StrictData would break it.
library wok-generated
    import:           warnings
    visibility:       public
    exposed-modules:
        GeneratedParser.Wok.Abs
        GeneratedParser.Wok.Lex
        GeneratedParser.Wok.Par
        GeneratedParser.Wok.Print
        GeneratedParser.Wok.Layout
        GeneratedParser.Wok.ErrM
    build-depends:
        base         ^>=4.20,
        array        ^>=0.5,
        text
    hs-source-dirs:   src-generated
    default-language: GHC2024
    -- NOTE: cabal auto-invokes alex (.x) and happy (.y) but NOT bnfc (.cf).
    -- BNFC is listed so `cabal install --only-dependencies` pulls it in; the
    -- grammar must still be regenerated manually after editing grammar/Wok.cf:
    --   bnfc --haskell -d --text-token -o src-generated grammar/Wok.cf
    build-tool-depends:
        BNFC:bnfc,
        alex:alex,
        happy:happy

-- Hand-written wok modules: strict by default. The TypeChecking
-- inferrer is fundamentally strict (in-place unification via ST,
-- monotonic counters, complete tree walks), so Strict/StrictData
-- is a uniform improvement.
library
    import:           strict
    exposed-modules:
        Wok.Loader
        Wok.Parsing
        Wok.Pipeline
        Wok.Prelude
        Wok.RecordLayout
        Wok.Reordering
        Wok.SourceOrigin
        Wok.TypeChecking
        Wok.TypeChecking.Types
        Wok.TypeChecking.Env
        Wok.TypeChecking.Error
        Wok.TypeChecking.Monad
        Wok.TypeChecking.Unify
        Wok.TypeChecking.Infer
        Wok.TypeChecking.Class
        Wok.TypeChecking.Builtins
        Wok.TypeChecking.Solve
        Wok.TypeChecking.Typed
        Wok.TypeChecking.Carrier
        Wok.IR.Name
        Wok.IR.Anf
        Wok.IR.Elaborate
        Wok.IR.Match
        Wok.IR.Multiplicity
        Wok.IR.Perceus
        Wok.IR.Reachable
        Wok.Interp
        Wok.Interp.Value
        Wok.Interp.Prim
        Wok.Interp.Sched
        Wok.Interp.Machine
        Wok.Interp.RC.Value
        Wok.Interp.RC.Prim
        Wok.Interp.RC.Machine
    autogen-modules:
        Paths_wok
    other-modules:
        Paths_wok
    build-depends:
        base         ^>=4.20,
        array        ^>=0.5,
        containers,
        mtl,
        text,
        transformers,
        wok:wok-generated
    hs-source-dirs:   src

executable wok
    import:           strict, executable-flags
    main-is:          Main.hs
    build-depends:
        base ^>=4.20,
        wok,
        containers,
        text
    hs-source-dirs:   app

test-suite wok-tests
    import:           strict
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    build-depends:
        base ^>=4.20,
        wok,
        wok:wok-generated,
        tasty,
        tasty-golden,
        tasty-hunit,
        tasty-quickcheck,
        QuickCheck,
        bytestring,
        containers,
        filepath,
        directory,
        mtl,
        text
    hs-source-dirs:   test
