module Std.Control
import Std.Base

effect Reader r = { ask : r }
reader : r -> (Reader r -> a with Reader r + eff e) -> a with eff e
reader e c = with self = Reader { ask -> e } in c self

effect State s = { get : s, set : s -> () }
state : s -> (State s -> a with State s + eff e) -> (a, s) with eff e
state i c = with self = State { s = i ; get -> s ; set x k -> k x () ; v -> (v, s) } in c self

effect Writer w = { tell : w -> () }
writer : (Writer [w] -> a with Writer [w] + eff e) -> (a, [w]) with eff e
writer c = with self = Writer { log = [] ; tell w k -> k (log ++ w) () ; v -> (v, log) } in c self

effect Except e = { throw : e -> Never }
except : (Except e -> a with Except e + eff r) -> Result a e with eff r
except c = with self = Except { throw e k -> Err e ; v -> Ok v } in c self

-- Coro: the escaping one-shot coroutine. `suspend` yields an `a` and gets a `b`
-- back when the parked continuation is resumed. The continuation lives below the
-- effect boundary as an opaque `Future` handle (second-class via the carrier rule);
-- `Future a b r` has NO user-visible constructors.
effect Coro a b = { suspend : a -> b }

-- Trusted bodyless builtin signatures (bind to prims by name at runtime).
-- __coro_susp decouples the continuation slot (b -> s) from the future's r so the
-- suspend arm's k : b -> <answer = Future a b r> unifies without an occurs-check.
extern __coro_susp   : a -> (b -> s) -> Future a b r
extern __coro_resume : Future a b r -> b -> Future a b r
extern __coro_unwrap : Future a b r -> r
extern __coro_done   : r -> Future a b r
extern __coro_cancel : Future a b r -> ()

-- `start` installs the Coro handler and runs the producer to its first suspension,
-- returning the opaque Future. The suspend arm packs (yielded value, captured
-- continuation) into a Suspended future; the value arm tags a completed result.
start : (() -> r with Coro a b) -> Future a b r
start c = with Coro { suspend x k -> __coro_susp x k ; v -> __coro_done v } (c ())

-- `value` reads the yielded value (non-consuming; may be read any number of
-- times). It is a direct `extern` bound to the value-projection prim, so the
-- affine check recognises it as the trusted non-consuming reader by EXTERN
-- IDENTITY (not by name): a user binding named `value` is a regular function, not
-- this extern, and is treated as a consumer.
extern value : Future a b r -> a

-- `resume` runs the parked continuation once with `v`, delivering the producer's
-- result `r`. __coro_resume re-installs the Coro handler (deep re-install), the
-- producer's tail runs through the value arm to a Completed future, __coro_unwrap
-- peels it to r.
resume : Future a b r -> b -> r
resume s v = __coro_unwrap (__coro_resume s v)

-- `cancel` consumes the future WITHOUT resuming it, dropping the parked
-- continuation and returning unit. It is a consuming use, mutually exclusive
-- with `resume`: a future may be `resume`d XOR `cancel`led, at most once total
-- (enforced by the affine consumption check, which counts `resume`/`cancel`
-- applied to a Future-typed binding; `value` reads do NOT count).
cancel : Future a b r -> ()
cancel s = __coro_cancel s

-- `step` resumes the parked continuation ONCE with `v`, then dispatches: the
-- producer either completed (onDone r) or suspended again (onYield x s'), where
-- s' is the tail future, SECOND-CLASS (a Future-typed lambda param: the carrier
-- rule makes it second-class; the affine rule counts it as consumed when threaded
-- on). The total, generator-safe counterpart of `resume` (which assumes a single
-- suspension and crashes on re-suspend). `step` consumes its input future (passed
-- as an argument) and produces a fresh tail s' the onYield branch consumes.
--
-- ARGUMENT ORDER IS LOAD-BEARING (sugar-readiness): the deferred named-arm sugar
--   step e v of done r -> b1 ; yield x s' -> b2
-- desugars positionally to
--   step e v (\r -> b1) (\x s' -> b2)
-- so `step` MUST stay (future, value, onDone, onYield) with onDone : r -> t and
-- onYield : a -> Future a b r -> t. Do not reorder.
extern __coro_step : Future a b r -> (r -> t) -> (a -> Future a b r -> t) -> t

step : Future a b r -> b -> (r -> t) -> (a -> Future a b r -> t) -> t
step f v onDone onYield = __coro_step (__coro_resume f v) onDone onYield
