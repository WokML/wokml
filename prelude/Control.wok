module Control
import Base

effect Reader r = { ask : r }
reader : r -> (Reader r -> a with Reader r + eff e) -> a with eff e
reader e c = with self = Reader { ask -> e } in c self

effect State s = { get : s, set : s -> () }
state : s -> (State s -> a with State s + eff e) -> (a, s) with eff e
state i c = with self = State { var s = i ; get -> s ; once set x k -> k x () ; return v -> (v, s) } in c self

effect Writer w = { tell : w -> () }
writer : (Writer [w] -> a with Writer [w] + eff e) -> (a, [w]) with eff e
writer c = with self = Writer { var log = [] ; once tell w k -> k (log ++ w) () ; return v -> (v, log) } in c self

effect Except e = { throw : e -> Never }
except : (Except e -> a with Except e + eff r) -> Result a e with eff r
except c = with self = Except { once throw e k -> Err e ; return v -> Ok v } in c self

-- the producer effect is unchanged
effect Coro a b = { suspend : a -> b }

-- COROUTINE TYPES (prelude-declared `extern`; slice 4d).
--
-- `Suspension` is the opaque, second-class, affine parked producer: you never
-- construct one; you obtain it from a `Suspended` arm and feed it to
-- `step`/`run`/`cancel`. `Step` is the closed outcome of one step; eliminate it
-- with an ordinary `case` (both arms). Their carrier + consume-once discipline
-- rides the `extern` marker (Embedded-only), not the names.
extern type Suspension a b r (row e)

extern data Step a b r (row e) = Completed r | Suspended a (Suspension a b r (row e))

-- Trusted builtins. Implementations are UNCHANGED (e is phantom at runtime); only the
-- wok-level signatures gain the residual row e. __coro_susp keeps the continuation slot
-- decoupled (b -> s) so the suspend arm unifies without an occurs-check; the continuation
-- performs e on resume.
extern __coro_susp   : a -> (b -> s with eff e) -> Step a b r (row e)
extern __coro_resume : Suspension a b r (row e) -> b -> Step a b r (row e) with eff e
extern __coro_unwrap : Step a b r (row e) -> r                   -- pure projection; partial on Suspended (run's fail state, deferred)
extern __coro_done   : r -> Step a b r (row e)
extern __coro_cancel : Suspension a b r (row e) -> ()

-- STORED / ESCAPING CONTINUATIONS (prelude-declared `extern`; M3-a).
--
-- `ContCell` is the opaque, second-class, affine continuation cell: a one-shot
-- park slot held in a scheduler handler's baton. You never construct one by
-- hand other than via `__cont_cell_new`, and you feed it to `__cont_store`
-- (move-in) / `__cont_take` (move-out). Its carrier + consume-once discipline
-- rides the `extern type` marker (Embedded-only), not the name.
extern type ContCell r (row e)
--
-- `__cont_store` is the trusted ONCE-SINK: it moves the op-arm continuation `k`
-- into the cell exactly once (no `dup`; the binder is consumed) and RETURNS the
-- (now-filled) cell. Mirroring `__coro_susp`, the continuation slot is a plain
-- function `(b -> r with eff e)` decoupled from the cell, so the op-arm
-- `op x k -> __cont_store cell k` unifies without an occurs-check; the
-- continuation performs `e` on resume. The multiplicity analysis charges this
-- slot `One` by EXTERN IDENTITY.
--
-- WHY store RETURNS the cell (M3-b, Design A): the reference oracle models the
-- cell as an IMMUTABLE value (a pure CEK machine has no value store to mutate),
-- so the filled cell must be threaded forward as a value; the program
-- `__cont_take`s the RETURNED handle. The RC machine fills the cell in place and
-- returns the SAME handle, so the differential agrees. (The multiplicity card is
-- unaffected: the return is a cell, not the continuation.)
extern __cont_cell_new : () -> ContCell r (row e)
extern __cont_store    : ContCell r (row e) -> (b -> r with eff e) -> ContCell r (row e)
extern __cont_take     : ContCell r (row e) -> (b -> r with eff e)

-- start: install Coro, run the producer to its first suspension, return the FIRST
-- outcome as a Step. e = the producer's NON-Coro residual: emitted at the start site
-- (before-suspend effects) AND captured into the Step (performed on resume).
start : (() -> r with Coro a b + eff e) -> Step a b r (row e) with eff e
start c = with Coro { once suspend x k -> __coro_susp x k ; return v -> __coro_done v } (c ())

-- step: resume once; the tail performs e, so the resume site must handle e.
step : Suspension a b r (row e) -> b -> Step a b r (row e) with eff e
step s v = __coro_resume s v

-- run: single-shot convenience. Resumes once (performing e) and assumes completion;
-- if the producer RE-SUSPENDS this still errors at runtime (documented partiality -- the
-- residual row tracks effects, not completion; run's totality is the deferred
-- failure-model slice). run reveals the tail's effects via `with eff e`.
run : Suspension a b r (row e) -> b -> r with eff e
run s v = __coro_unwrap (__coro_resume s v)

-- cancel: discard a suspension without resuming it. The tail never runs, so cancel
-- performs nothing and carries NO residual row. Note this is NOT an escape from the
-- residual obligation: `start` already demands `e` at the start site (its input and
-- output share the same `e`), so an unhandleable tail is rejected before any
-- suspension exists to cancel. cancel's purpose is to skip the tail's work/effects,
-- not to launder its type.
cancel : Suspension a b r (row e) -> ()
cancel s = __coro_cancel s

-- ---------------------------------------------------------------------------
-- Two-coroutine lockstep driver (slice async-par).
--
-- Runs two coroutines (each `Coro () ()`, i.e. yields/resumes with unit) to
-- completion and returns both results. Carriers are held only as recursive
-- ARGUMENTS (second-class, never stored/returned); each is `step`-ped at most
-- once per round, so one-shot holds. Lockstep (advance both per round) is the
-- deterministic interleave schedule. This is `coro-step-zip`'s `zipSum` shape
-- plus result-combination and per-side drain.
-- drainOne: drive a single Step (Coro () ()) to completion, returning its result.
-- Used when the other side has already finished; the carrier is `step`-ped once
-- per round (second-class, recursive arg) so one-shot holds.
drainOne : Step () () r (row e) -> r with eff e
drainOne s = case s of
  Completed r   -> r
  Suspended _ g -> drainOne (step g ())

parBoth : Step () () ra (row e) -> Step () () rb (row e) -> (ra, rb) with eff e
parBoth sa sb = case sa of
  Completed ra -> case sb of
    Completed rb   -> (ra, rb)
    Suspended _ gb -> (ra, drainOne (step gb ()))
  Suspended _ ga -> case sb of
    Completed rb   -> (drainOne (step ga ()), rb)
    -- Sequence the two resumptions explicitly (A's round before B's) so the
    -- cross-side order of residual effects is fixed by the driver, not by the
    -- interpreter's argument-evaluation order.
    Suspended _ gb ->
      let sa2 = step ga () in
      let sb2 = step gb () in
      parBoth sa2 sb2

-- ---------------------------------------------------------------------------
-- Async surface (slice async-par). `par` is a built-in DRIVER over `Async`,
-- expressed over the coroutine machinery -- not a runtime (no IO/scheduler).

-- Async: the cooperative-scheduling effect. `yield` is a breakpoint: the task
-- parks and hands control to its driver.
effect Async = { yield : () -> () }

-- asCoro: adapt an `Async` child to a coroutine by mapping `Async.yield` to
-- `Coro.suspend` (yield/resume carry unit). Discharges Async, introduces Coro;
-- the child's non-Async residual e flows through.
asCoro : (() -> r with Async + eff e) -> () -> r with Coro () () + eff e
asCoro c _ = with Async { once yield _ k -> k (Coro.suspend ()) } (c ())

-- par: run two Async children concurrently (deterministic lockstep) and return
-- both results. Discharges Async (and Coro); the children's residual e is
-- demanded here, at the call site (resume-site). Deterministic => no ndet.
par : (() -> ra with Async + eff e) -> (() -> rb with Async + eff e) -> (ra, rb) with eff e
par a b = parBoth (start (asCoro a)) (start (asCoro b))

-- ---------------------------------------------------------------------------
-- race (slice async-race): run two Async children, first to COMPLETE wins; the
-- loser is dropped (its carrier goes unused -> remaining tail never runs =
-- cooperative cancellation, pure control-flow, no keyword). A neutral combinator
-- like `par` -- determinism is not a tracked property here; nondeterminism (a
-- real scheduler) would enter later as a foreign effect in the row, not a marker.
-- On a tie (both complete the same lockstep round) the LEFT child wins.

-- runRace: lockstep-drive two coroutines; return the first to Complete (left-
-- biased on a tie), dropping the other.
runRace : Step () () r (row e) -> Step () () r (row e) -> r with eff e
runRace sa sb = case sa of
  Completed ra -> case sb of
    Completed rb   -> ra
    Suspended _ gb -> ra
  Suspended _ ga -> case sb of
    Completed rb   -> rb
    Suspended _ gb ->
      let sa2 = step ga () in
      let sb2 = step gb () in
      runRace sa2 sb2

race : (() -> r with Async + eff e) -> (() -> r with Async + eff e) -> r with eff e
race a b = runRace (start (asCoro a)) (start (asCoro b))

-- ============ Conc: provider-scheduled concurrency (slice 3, Provider A) ============
-- Handles are PLAIN DATA wrapping a provider id (first-class; the real carriers live in
-- the Haskell scheduler keyed by id). A Fiber is a lightweight cooperatively-scheduled
-- computation (NOT an OS thread).
data Fiber     = Fiber U64
data Promise a = Promise U64        -- `a` PHANTOM: surface type-safety, erased at runtime
data Chan a    = Chan U64           -- `a` PHANTOM

-- Transport: a type-erased value in transit. Plain data, so first-class and storable in
-- Request; the U64 slot is a label only, gated by erase/recall. `__coerce` is the one
-- trusted runtime-identity retype.
data Transport = Transport U64
extern __coerce : a -> b

erase : a -> Transport
erase v = Transport (__coerce v)

recall : Transport -> a
recall t = case t of Transport n -> __coerce n

recallId : Transport -> U64
recallId t = recall t

-- Request: the transport message. ReqSpawn/ReqAsync carry the adapted coro thunk ERASED
-- into Transport (so the field is plain Transport, not an effectful function type).
data Request
  = ReqYield
  | ReqSpawn Transport
  | ReqAsync Transport
  | ReqAwait U64
  | ReqNewChan
  | ReqSend U64 Transport
  | ReqRecv U64
-- Cancellation (`cancel` / a `ReqCancel` request) is deferred to a later slice:
-- it needs fiber-id tracking plus finalizers, neither of which exists yet.

effect Conc = { req : Request -> Transport }

asConc : (() -> a with Conc + eff e) -> () -> a with Coro Request Transport + eff e
asConc c _ = with Conc { once req r k -> k (Coro.suspend r) } (c ())

-- driveConc (Haskell) has no global env, so it cannot call the wok `start`. The
-- wok side hands it already-`start`-wrapped STARTER THUNKS: each `() -> Step ...`,
-- when applied to `()`, installs Coro and runs the producer to its first Step.
--
-- Effect-closed driven thunk (no residual row). Provider A (driveConc) resumes
-- every coroutine segment under a fresh `KDone`, i.e. WITHOUT the ambient handler
-- context, so it can only run a thunk that is effect-closed up to `Conc`. The
-- thunk type therefore carries NO `with eff e`: the driver makes no claim it
-- cannot honour. (`Step`'s `(row e)` DOES track the residual effect row elsewhere
-- in this module; here, with no `with eff e` alongside it, `e` is simply
-- unconstrained -- always empty -- at this one call site.) A non-`Conc` effect
-- handled OUTSIDE the drive would be
-- severed by the `KDone` resume; requiring an effect-free thunk turns that from a
-- runtime `NoMatchingHandler` trap into a compile-time `RowMismatch` at the call
-- site (see `runConc`). Effects handled INSIDE the thunk are fine -- the carrier
-- captures their handler and re-installs it on resume.
extern __drive_conc : (() -> Step Request Transport a (row e)) -> a

-- The root must be effect-closed up to `Conc` (like `spawn`/`async` children).
-- A non-`Conc` effect handled INSIDE the root runs fine -- the coroutine carrier
-- captures its handler and re-installs it across every resume. A non-`Conc`
-- effect handled OUTSIDE `runConc` is rejected at COMPILE TIME (a `RowMismatch`
-- on the argument), rather than trapping at runtime under the scheduler's fresh
-- `KDone`. (Prior versions carried a phantom `+ eff e` that the scheduler could
-- never honour.)
--
-- CONSERVATISM (deferred, non-breaking to relax): the strict `with Conc` also
-- rejects a root performing a ground/foreign effect such as `IO`, which runs as
-- an in-place call and would NOT trap. Widening to `Conc + <ground effects>`
-- (forbidding only handler-dispatched residuals) needs the type system to
-- distinguish ground from handler effects; left for a follow-up.
--
-- Handle identity: Fiber/Promise/Chan handles are bound to the scheduler
-- instance that minted them. Using a handle under a different runConc (nested
-- or later) is a runtime error ("not owned by this scheduler"), never a
-- silent delivery. Nested runConc with its own handles is supported.
runConc : (() -> a with Conc) -> a
runConc c = __drive_conc (\ () -> start (asConc c))

yield : () -> () with Conc
yield u = let r = Conc.req ReqYield in ()

spawn : (() -> () with Conc) -> Fiber with Conc
spawn f = Fiber (recallId (Conc.req (ReqSpawn (erase (\ () -> start (asConc f))))))

async : (() -> a with Conc) -> Promise a with Conc
async f = Promise (recallId (Conc.req (ReqAsync (erase (\ () -> start (asConc (\ () -> erase (f ()))))))))

await : Promise a -> a with Conc
await p = recall (Conc.req (ReqAwait (promiseId p)))

newChan : () -> Chan a with Conc
newChan u = Chan (recallId (Conc.req ReqNewChan))

send : Chan a -> a -> () with Conc
send c v = let r = Conc.req (ReqSend (chanId c) (erase v)) in ()

recv : Chan a -> a with Conc
recv c = recall (Conc.req (ReqRecv (chanId c)))

promiseId : Promise a -> U64
promiseId p = case p of Promise n -> n
chanId : Chan a -> U64
chanId c = case c of Chan n -> n

parAll : [() -> a with Conc] -> [a] with Conc
parAll fs = mapAwait (mapAsync fs)

mapAsync : [() -> a with Conc] -> [Promise a] with Conc
mapAsync fs = case fs of
  []      -> []
  g :: gs -> [async g] ++ mapAsync gs

mapAwait : [Promise a] -> [a] with Conc
mapAwait ps = case ps of
  []      -> []
  p :: qs -> [await p] ++ mapAwait qs

-- raceAny: TRUE first-to-complete race. Spawn each child to SEND its result to a
-- shared channel, then `recv` once: the first value buffered = the first child to
-- complete (under the deterministic schedule). Losers are DROPPED un-resumed once
-- the root completes (daemonic, early-return drain): the scheduler returns the
-- root's result and never re-enters still-ready/parked fibers, so a diverging
-- loser cannot hang the program. No explicit cancellation -- fine for
-- pure-up-to-Conc children. Reuses existing primitives (no scheduler change).
raceAny : [() -> a with Conc] -> a with Conc
raceAny fs =
  let ch = newChan () in
  let started = raceSpawn ch fs in
  recv ch

raceSpawn : Chan a -> [() -> a with Conc] -> [Fiber] with Conc
raceSpawn ch fs = case fs of
  []      -> []
  f :: gs -> [spawn (\ () -> send ch (f ()))] ++ raceSpawn ch gs
